<Window x:Class="Proyecto_MediSys.Controls.ConsumosInternamientoDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Consumos de Internamiento"
        Width="1100"
        Height="720"
        MinWidth="980"
        MinHeight="650"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        Background="#F4F6F8">

    <Window.Resources>

        <!-- BOTÓN PRINCIPAL -->

        <Style x:Key="PrimaryButtonStyle"
               TargetType="Button">

            <Setter Property="Height"
                    Value="38"/>

            <Setter Property="Padding"
                    Value="16,0"/>

            <Setter Property="Background"
                    Value="#2563EB"/>

            <Setter Property="Foreground"
                    Value="White"/>

            <Setter Property="BorderThickness"
                    Value="0"/>

            <Setter Property="FontWeight"
                    Value="SemiBold"/>

            <Setter Property="FontSize"
                    Value="12"/>

            <Setter Property="Cursor"
                    Value="Hand"/>

        </Style>


        <!-- BOTÓN QUITAR -->

        <Style x:Key="RemoveButtonStyle"
               TargetType="Button">

            <Setter Property="Width"
                    Value="72"/>

            <Setter Property="Height"
                    Value="30"/>

            <Setter Property="Padding"
                    Value="8,0"/>

            <Setter Property="Background"
                    Value="#FEF2F2"/>

            <Setter Property="Foreground"
                    Value="#B91C1C"/>

            <Setter Property="BorderBrush"
                    Value="#FECACA"/>

            <Setter Property="BorderThickness"
                    Value="1"/>

            <Setter Property="FontSize"
                    Value="11"/>

            <Setter Property="FontWeight"
                    Value="SemiBold"/>

            <Setter Property="Cursor"
                    Value="Hand"/>

        </Style>

    </Window.Resources>


    <Grid>

        <Grid.RowDefinitions>

            <RowDefinition Height="76"/>

            <RowDefinition Height="*"/>

            <RowDefinition Height="65"/>

        </Grid.RowDefinitions>


        <!-- =====================================================
                     ENCABEZADO
====================================================== -->

        <Border Grid.Row="0"
        Background="#2F5FE3"
        Padding="24,14">

            <Grid>

                <StackPanel
            VerticalAlignment="Center">

                    <TextBlock
                Text="CONSUMOS DEL INTERNAMIENTO"
                FontSize="22"
                FontWeight="Bold"
                Foreground="White"/>

                    <StackPanel
                Orientation="Horizontal"
                Margin="0,5,0,0">

                        <TextBlock
                    x:Name="txtCodigoInternamiento"
                    Text="INT000001"
                    FontSize="13"
                    FontWeight="SemiBold"
                    Foreground="#DCE7FF"/>

                        <TextBlock
                    Text="  •  "
                    FontSize="13"
                    Foreground="#93C5FD"/>

                        <TextBlock
                    Text="Paciente: "
                    FontSize="13"
                    Foreground="#BFDBFE"/>

                        <TextBlock
                    x:Name="txtPaciente"
                    Text="Nombre del paciente"
                    FontSize="13"
                    FontWeight="SemiBold"
                    Foreground="White"/>

                    </StackPanel>

                </StackPanel>

            </Grid>

        </Border>


        <!-- =====================================================
                              CONTENIDO
        ====================================================== -->

        <Grid
            Grid.Row="1"
            Margin="24,20">

            <Grid.RowDefinitions>

                <RowDefinition Height="Auto"/>

                <RowDefinition Height="Auto"/>

                <RowDefinition Height="*"/>

            </Grid.RowDefinitions>


            <!-- =================================================
                           INFORMACIÓN DEL PLAN
            ================================================== -->

            <Border
                Grid.Row="0"
                Background="White"
                BorderBrush="#E2E8F0"
                BorderThickness="1"
                CornerRadius="10"
                Padding="15"
                Margin="0,0,0,14">

                <Grid>

                    <Grid.ColumnDefinitions>

                        <ColumnDefinition/>

                        <ColumnDefinition Width="Auto"/>

                    </Grid.ColumnDefinitions>


                    <StackPanel>

                        <TextBlock
                            Text="Plan tarifario aplicado"
                            FontSize="10"
                            Foreground="#64748B"/>

                        <TextBlock
                            x:Name="txtPlanTarifario"
                            Text="Plan"
                            FontSize="14"
                            FontWeight="SemiBold"
                            Foreground="#172033"
                            Margin="0,3,0,0"/>

                    </StackPanel>


                    <StackPanel
                        Grid.Column="1"
                        HorizontalAlignment="Right">

                        <TextBlock
                            Text="Subtotal de consumos"
                            FontSize="10"
                            Foreground="#64748B"
                            HorizontalAlignment="Right"/>

                        <TextBlock
                            x:Name="txtSubtotal"
                            Text="RD$ 0.00"
                            FontSize="20"
                            FontWeight="Bold"
                            Foreground="#2563EB"
                            HorizontalAlignment="Right"
                            Margin="0,3,0,0"/>

                    </StackPanel>

                </Grid>

            </Border>


            <!-- =================================================
                         AGREGAR NUEVO CONSUMO
            ================================================== -->

            <Border
                Grid.Row="1"
                Background="White"
                BorderBrush="#E2E8F0"
                BorderThickness="1"
                CornerRadius="10"
                Padding="16"
                Margin="0,0,0,14">

                <Grid>

                    <Grid.RowDefinitions>

                        <RowDefinition Height="Auto"/>

                        <RowDefinition Height="Auto"/>

                    </Grid.RowDefinitions>


                    <Grid>

                        <Grid.ColumnDefinitions>

                            <ColumnDefinition Width="180"/>

                            <ColumnDefinition Width="*"/>

                            <ColumnDefinition Width="100"/>

                            <ColumnDefinition Width="125"/>

                        </Grid.ColumnDefinitions>


                        <!-- TIPO -->

                        <StackPanel
                            Grid.Column="0"
                            Margin="0,0,10,0">

                            <TextBlock
                                Text="Tipo de consumo"
                                FontSize="10"
                                Foreground="#64748B"
                                Margin="0,0,0,5"/>

                            <ComboBox
                                x:Name="cmbTipoConsumo"
                                Height="38"
                                Padding="8,3"
                                Background="#F8FAFC"
                                BorderBrush="#CBD5E1"
                                SelectionChanged="cmbTipoConsumo_SelectionChanged">

                                <ComboBoxItem
                                    Content="Medicamento"/>

                                <ComboBoxItem
                                    Content="Material gastable"/>

                                <ComboBoxItem
                                    Content="Procedimiento"/>

                                <ComboBoxItem
                                    Content="Laboratorio"/>

                                <ComboBoxItem
                                    Content="Imagen"/>

                            </ComboBox>

                        </StackPanel>


                        <!-- BUSCAR -->

                        <StackPanel
                            Grid.Column="1"
                            Margin="0,0,10,0">

                            <TextBlock
                                Text="Buscar servicio"
                                FontSize="10"
                                Foreground="#64748B"
                                Margin="0,0,0,5"/>

                            <TextBox
                                x:Name="txtBuscar"
                                Height="38"
                                Padding="10,5"
                                Background="#F8FAFC"
                                BorderBrush="#CBD5E1"
                                VerticalContentAlignment="Center"
                                TextChanged="txtBuscar_TextChanged"/>

                        </StackPanel>


                        <!-- CANTIDAD -->

                        <StackPanel
                            Grid.Column="2"
                            Margin="0,0,10,0">

                            <TextBlock
                                Text="Cantidad"
                                FontSize="10"
                                Foreground="#64748B"
                                Margin="0,0,0,5"/>

                            <TextBox
                                x:Name="txtCantidad"
                                Height="38"
                                Text="1"
                                Background="#F8FAFC"
                                BorderBrush="#CBD5E1"
                                HorizontalContentAlignment="Center"
                                VerticalContentAlignment="Center"/>

                        </StackPanel>


                        <!-- AGREGAR -->

                        <Button
                            x:Name="btnAgregar"
                            Grid.Column="3"
                            Height="38"
                            VerticalAlignment="Bottom"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Content="+ Agregar"
                            Click="btnAgregar_Click"/>

                    </Grid>


                    <!-- RESULTADOS -->

                    <ListBox
                        x:Name="lstCatalogo"
                        Grid.Row="1"
                        Height="78"
                        Margin="0,10,0,0"
                        Background="#F8FAFC"
                        BorderBrush="#E2E8F0"
                        BorderThickness="1"
                        DisplayMemberPath="Mostrar"/>

                </Grid>

            </Border>


            <!-- =================================================
                             CONSUMOS
            ================================================== -->

            <Border
                Grid.Row="2"
                Background="White"
                BorderBrush="#E2E8F0"
                BorderThickness="1"
                CornerRadius="10"
                Padding="14">

                <Grid>

                    <Grid.RowDefinitions>

                        <RowDefinition Height="Auto"/>

                        <RowDefinition Height="*"/>

                    </Grid.RowDefinitions>


                    <TextBlock
                        Text="Consumos registrados"
                        FontSize="14"
                        FontWeight="SemiBold"
                        Foreground="#172033"
                        Margin="2,0,0,10"/>


                    <DataGrid
                        x:Name="dgConsumos"
                        Grid.Row="1"
                        AutoGenerateColumns="False"
                        CanUserAddRows="False"
                        IsReadOnly="True"
                        HeadersVisibility="Column"
                        GridLinesVisibility="Horizontal"
                        BorderBrush="#E2E8F0"
                        BorderThickness="1"
                        MinRowHeight="48"
                        FontSize="11">

                        <DataGrid.Columns>


                            <DataGridTextColumn
                                Header="Tipo"
                                Binding="{Binding TipoItem}"
                                Width="125"/>


                            <DataGridTextColumn
                                Header="Código"
                                Binding="{Binding Codigo}"
                                Width="90"/>


                            <DataGridTextColumn
                                Header="Servicio"
                                Binding="{Binding Nombre}"
                                Width="*"/>


                            <DataGridTextColumn
                                Header="Cantidad"
                                Binding="{Binding CantidadTexto}"
                                Width="80"/>


                            <DataGridTextColumn
                                Header="Precio"
                                Binding="{Binding PrecioTexto}"
                                Width="105"/>


                            <DataGridTextColumn
                                Header="Total"
                                Binding="{Binding TotalTexto}"
                                Width="105"/>


                            <DataGridTextColumn
                                Header="Estado"
                                Binding="{Binding Estado}"
                                Width="90"/>


                            <DataGridTemplateColumn
                                Header="Acción"
                                Width="95">

                                <DataGridTemplateColumn.CellTemplate>

                                    <DataTemplate>

                                        <Button
                                            Style="{StaticResource RemoveButtonStyle}"
                                            Content="Quitar"
                                            Click="btnQuitar_Click"/>

                                    </DataTemplate>

                                </DataGridTemplateColumn.CellTemplate>

                            </DataGridTemplateColumn>

                        </DataGrid.Columns>

                    </DataGrid>

                </Grid>

            </Border>

        </Grid>


        <!-- =====================================================
                             PIE
        ====================================================== -->

        <Border
            Grid.Row="2"
            Background="White"
            BorderBrush="#E2E8F0"
            BorderThickness="0,1,0,0">

            <StackPanel
                Orientation="Horizontal"
                HorizontalAlignment="Right"
                VerticalAlignment="Center"
                Margin="20,0">

                <Button
                    Width="120"
                    Height="38"
                    Content="Cerrar"
                    Background="#F1F5F9"
                    Foreground="#334155"
                    BorderBrush="#CBD5E1"
                    FontWeight="SemiBold"
                    Cursor="Hand"
                    Click="btnCerrar_Click"/>

            </StackPanel>

        </Border>

    </Grid>

</Window>