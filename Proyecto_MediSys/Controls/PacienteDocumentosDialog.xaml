<UserControl x:Class="Proyecto_MediSys.Controls.PacienteDocumentosDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignWidth="1000"
             d:DesignHeight="700">

    <Grid Background="#66000000">

        <Border Width="900"
                Padding="30"
                Background="White"
                CornerRadius="15"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">

            <Grid>
                <Grid.RowDefinitions>

                    <!-- Encabezado -->
                    <RowDefinition Height="Auto"/>

                    <!-- Separador -->
                    <RowDefinition Height="15"/>

                    <!-- Línea -->
                    <RowDefinition Height="Auto"/>

                    <!-- Espacio -->
                    <RowDefinition Height="20"/>

                    <!-- Panel superior -->
                    <RowDefinition Height="Auto"/>

                    <!-- Espacio -->
                    <RowDefinition Height="20"/>

                    <!-- DataGrid -->
                    <RowDefinition Height="250"/>

                    <!-- Espacio -->
                    <RowDefinition Height="20"/>

                    <!-- Botones -->
                    <RowDefinition Height="Auto"/>

                </Grid.RowDefinitions>

                <!-- Título -->

                <StackPanel Grid.Row="0">

                    <TextBlock
                        Text="Documentos del Paciente"
                        FontSize="28"
                        FontWeight="Bold"
                        Foreground="#1E293B"/>

                    <TextBlock
                        Text="Adjunte y administre todos los documentos del paciente."
                        Margin="0,5,0,0"
                        FontSize="15"
                        Foreground="Gray"/>

                </StackPanel>

                <Separator Grid.Row="2"/>

                <!-- CARGA DE DOCUMENTOS -->

                <Border Grid.Row="4"
                    Background="#F8FAFC"
                    BorderBrush="#E2E8F0"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="20">

                    <Grid>

                        <Grid.ColumnDefinitions>

                            <ColumnDefinition Width="2*"/>

                            <ColumnDefinition Width="20"/>

                            <ColumnDefinition Width="*"/>

                        </Grid.ColumnDefinitions>

                        <!-- LADO IZQUIERDO -->

                        <StackPanel Grid.Column="0">

                            <TextBlock
                                Text="Tipo de documento"
                                FontWeight="SemiBold"/>

                            <ComboBox
                                x:Name="cmbTipoDocumento"
                                Margin="0,8,0,15"
                                Height="40">

                                <ComboBoxItem Content="Seleccione..."/>
                                <ComboBoxItem Content="Cédula (Frente)"/>
                                <ComboBoxItem Content="Cédula (Reverso)"/>
                                <ComboBoxItem Content="Pasaporte"/>
                                <ComboBoxItem Content="Seguro Médico"/>
                                <ComboBoxItem Content="Consentimiento"/>
                                <ComboBoxItem Content="Referencia Médica"/>
                                <ComboBoxItem Content="Estudio Médico"/>
                                <ComboBoxItem Content="Otro"/>

                            </ComboBox>

                            <TextBlock
                                Text="Archivo"
                                FontWeight="SemiBold"/>

                            <DockPanel Margin="0,8,0,0">

                                <TextBox
                                    x:Name="txtRutaArchivo"
                                    Height="40"
                                    IsReadOnly="True"
                                    VerticalContentAlignment="Center"/>

                                <Button
                                    x:Name="btnExaminar"
                                    Width="120"
                                    Margin="10,0,0,0"
                                    Content="📂 Examinar"
                                    Click="btnExaminar_Click"/>     

                            </DockPanel>

                        </StackPanel>

                        <!-- LADO DERECHO -->

                        <Border Grid.Column="2"
                            Background="White"
                            BorderBrush="#CBD5E1"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="15">

                            <Grid>

                                <Image
                                    x:Name="imgVistaPrevia"
                                    Stretch="Uniform"
                                    Visibility="Collapsed"/>

                                <StackPanel
                                        x:Name="panelSinDocumento"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center">

                                    <TextBlock
                                        Text="📄"
                                        FontSize="55"
                                        HorizontalAlignment="Center"/>

                                    <TextBlock
                                        Text="Vista previa"
                                        FontWeight="Bold"
                                        FontSize="16"
                                        Margin="0,10,0,5"
                                        HorizontalAlignment="Center"/>

                                    <TextBlock
                                        Text="Seleccione un documento."
                                        Foreground="Gray"
                                        TextAlignment="Center"/>        

                                </StackPanel>

                            </Grid>

                        </Border>

                    </Grid>

                </Border>

                <!-- DOCUMENTOS REGISTRADOS -->

                <GroupBox Grid.Row="6"
          Header="Documentos registrados">

                    <DataGrid
        x:Name="dgDocumentos"
        AutoGenerateColumns="False"
        CanUserAddRows="False"
        IsReadOnly="True"
        SelectionMode="Single"
        Margin="10"
        GridLinesVisibility="Horizontal"
        RowHeight="40"
        HeadersVisibility="Column"
        Background="White"
        BorderThickness="0">

                        <DataGrid.Columns>

                            <DataGridTextColumn
                Header="Tipo"
                Width="180"
                Binding="{Binding TipoDocumento}" />

                            <DataGridTextColumn
                Header="Archivo"
                Width="*"
                Binding="{Binding NombreArchivo}" />

                            <DataGridTextColumn
                Header="Fecha"
                Width="140"
                Binding="{Binding FechaRegistro}" />

                            <DataGridTextColumn
                Header="Tamaño"
                Width="100"
                Binding="{Binding Tamano}" />

                            <DataGridTextColumn
                Header="Estado"
                Width="120"
                Binding="{Binding Estado}" />

                        </DataGrid.Columns>

                    </DataGrid>

                </GroupBox>

                <!-- BOTONES -->

                <StackPanel Grid.Row="8"
            Orientation="Horizontal"
            HorizontalAlignment="Right">

                    <Button
                        x:Name="btnAgregar"
                        Width="120"
                        Height="40"
                        Margin="0,0,10,0"
                        Content="➕ Agregar"
                        Click="btnAgregar_Click"/>

                    <Button
                        x:Name="btnVer"
                        Width="120"
                        Height="40"
                        Margin="0,0,10,0"
                        Content="👁 Ver"
                        Click="btnVer_Click"/>   

                    <Button
                        x:Name="btnDescargar"
                        Width="120"
                        Height="40"
                        Margin="0,0,10,0"
                        Content="⬇ Descargar"
                        Click="btnDescargar_Click"/>

                    <Button
                        x:Name="btnImprimir"
                        Width="120"
                        Height="40"
                        Margin="0,0,10,0"
                        Content="🖨 Imprimir"
                        Click="btnImprimir_Click"/>

                    <Button
                        x:Name="btnEliminar"
                        Width="120"
                        Height="40"
                        Margin="0,0,10,0"
                        Background="#DC2626"
                        Foreground="White"
                        Content="🗑 Eliminar"
                        Click="btnEliminar_Click"/>

                    <Button
                        x:Name="btnCerrar"
                        Width="120"
                        Height="40"
                        Content="✖ Cerrar"
                        Click="btnCerrar_Click"/>

                </StackPanel>

            </Grid>

        </Border>

    </Grid>

</UserControl>