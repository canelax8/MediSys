<Window x:Class="Proyecto_MediSys.Controls.AltaInternamientoDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Alta médica"
        Width="650"
        Height="510"
        MinWidth="600"
        MinHeight="470"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        Background="#F4F6F8">

    <Grid Margin="22">

        <Grid.RowDefinitions>

            <RowDefinition Height="Auto"/>

            <RowDefinition Height="*"/>

            <RowDefinition Height="Auto"/>

        </Grid.RowDefinitions>


        <!-- ENCABEZADO -->

        <Border
            Grid.Row="0"
            Background="White"
            BorderBrush="#E2E8F0"
            BorderThickness="1"
            CornerRadius="10"
            Padding="18"
            Margin="0,0,0,14">

            <StackPanel>

                <TextBlock
                    Text="ALTA MÉDICA"
                    FontSize="21"
                    FontWeight="Bold"
                    Foreground="#287A4B"/>

                <TextBlock
                    Text="Finalice el internamiento y libere la cama del paciente."
                    Margin="0,4,0,0"
                    FontSize="11"
                    Foreground="#7A8798"/>

            </StackPanel>

        </Border>


        <!-- INFORMACIÓN -->

        <Border
            Grid.Row="1"
            Background="White"
            BorderBrush="#E2E8F0"
            BorderThickness="1"
            CornerRadius="10"
            Padding="18">

            <StackPanel>


                <Grid Margin="0,0,0,18">

                    <Grid.ColumnDefinitions>

                        <ColumnDefinition/>

                        <ColumnDefinition/>

                    </Grid.ColumnDefinitions>


                    <StackPanel Grid.Column="0">

                        <TextBlock
                            Text="Paciente"
                            FontSize="10"
                            Foreground="#64748B"/>

                        <TextBlock
                            x:Name="txtPaciente"
                            Text="—"
                            Margin="0,4,0,0"
                            FontSize="14"
                            FontWeight="SemiBold"
                            Foreground="#172033"/>

                    </StackPanel>


                    <StackPanel Grid.Column="1">

                        <TextBlock
                            Text="Internamiento"
                            FontSize="10"
                            Foreground="#64748B"/>

                        <TextBlock
                            x:Name="txtCodigo"
                            Text="—"
                            Margin="0,4,0,0"
                            FontSize="14"
                            FontWeight="SemiBold"
                            Foreground="#2457A6"/>

                    </StackPanel>

                </Grid>


                <Border
                    Background="#FFF8E8"
                    BorderBrush="#F1DFB8"
                    BorderThickness="1"
                    CornerRadius="7"
                    Padding="12"
                    Margin="0,0,0,18">

                    <TextBlock
                        x:Name="txtCama"
                        Text="La cama será liberada automáticamente."
                        TextWrapping="Wrap"
                        Foreground="#8A5A00"
                        FontSize="11"/>

                </Border>


                <TextBlock
                    Text="Observaciones del alta"
                    FontWeight="SemiBold"
                    FontSize="11"
                    Foreground="#475569"
                    Margin="0,0,0,6"/>


                <TextBox
                    x:Name="txtObservaciones"
                    Height="130"
                    Padding="10"
                    AcceptsReturn="True"
                    TextWrapping="Wrap"
                    VerticalScrollBarVisibility="Auto"
                    MaxLength="1000"/>

            </StackPanel>

        </Border>


        <!-- BOTONES -->

        <Border
            Grid.Row="2"
            Margin="0,14,0,0"
            Background="White"
            BorderBrush="#E2E8F0"
            BorderThickness="1"
            CornerRadius="10"
            Padding="14">

            <StackPanel
                Orientation="Horizontal"
                HorizontalAlignment="Right">

                <Button
                    Width="120"
                    Height="42"
                    Content="Cancelar"
                    Background="#E2E8F0"
                    Foreground="#334155"
                    BorderThickness="0"
                    FontWeight="SemiBold"
                    Click="btnCancelar_Click"/>


                <Button
                    Width="165"
                    Height="42"
                    Margin="10,0,0,0"
                    Content="Confirmar alta"
                    Background="#287A4B"
                    Foreground="White"
                    BorderThickness="0"
                    FontWeight="SemiBold"
                    Click="btnConfirmar_Click"/>

            </StackPanel>

        </Border>

    </Grid>

</Window>