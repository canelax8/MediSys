<Window x:Class="Proyecto_MediSys.Controls.EmergenciaDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:Proyecto_MediSys.Controls"
        Title="Nueva Emergencia"

        Width="1200"
        Height="760"

        MinWidth="1100"
        MinHeight="720"

        ResizeMode="CanResize"

        WindowStartupLocation="CenterOwner"

        Background="#F5F7FA">

    <Grid Margin="25">

        <!--========================
            GRID PRINCIPAL
        =========================-->

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition/>
            <RowDefinition Height="70"/>
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>

            <ColumnDefinition Width="250"/>

            <ColumnDefinition Width="20"/>

            <ColumnDefinition Width="*"/>

        </Grid.ColumnDefinitions>

        <!--========================
              ENCABEZADO
        =========================-->


        <StackPanel
            Grid.Row="0"
            Grid.ColumnSpan="3">

            <TextBlock
                Text="🚑 NUEVA EMERGENCIA"
                FontSize="30"
                FontWeight="Bold"
                Foreground="#1E3A8A"/>

            <TextBlock
                Margin="0,8,0,20"
                Text="Registro inicial del paciente en sala de emergencia."
                FontSize="15"
                Foreground="#64748B"/>
        </StackPanel>

        <!--========================
                CONTENIDO
        =========================-->

        <Border
            Grid.Row="1"
            Grid.Column="0"
            Background="White"
            CornerRadius="15"
            Padding="20">

            <StackPanel>

                <TextBlock
                    Text="PROCESO"
                    FontSize="20"
                    FontWeight="Bold"
                    Foreground="#1E3A8A"
                    Margin="0,0,0,25"/>

                <Border x:Name="Paso1Card"
                        Background="#2563EB"
                        CornerRadius="10"
                        Margin="0,0,0,10"
                        Padding="15">

                    <TextBlock
                        x:Name="txtPaso1"
                        Text="1 · Paciente"
                        FontWeight="SemiBold"
                        FontSize="14"/>

                </Border>

                <Border x:Name="Paso2Card"
                        Background="White"
                        BorderBrush="#D1D5DB"
                        BorderThickness="1"
                        CornerRadius="10"
                        Margin="0,0,0,10"
                        Padding="15">

                    <TextBlock
                        x:Name="txtPaso2"
                        Text="2 · Evaluación"
                        FontWeight="SemiBold"
                        FontSize="14"/>

                </Border>

                <Border x:Name="Paso3Card"
                        Background="White"
                        BorderBrush="#D1D5DB"
                        BorderThickness="1"
                        CornerRadius="10"
                        Margin="0,0,0,10"
                        Padding="15">

                    <TextBlock
                        x:Name="txtPaso3"
                        Text="3 · Información Clínica"
                        FontWeight="SemiBold"
                        FontSize="14"/>

                </Border>

                <Border x:Name="Paso4Card"
                        Background="White"
                        BorderBrush="#D1D5DB"
                        BorderThickness="1"
                        CornerRadius="10"
                        Margin="0,0,0,10"
                        Padding="15">

                    <TextBlock
                        x:Name="txtPaso4"
                        Text="4 · Diagnóstico"
                        FontWeight="SemiBold"
                        FontSize="14"/>

                </Border>

                <Border x:Name="Paso5Card"
                        Background="White"
                        BorderBrush="#D1D5DB"
                        BorderThickness="1"
                        CornerRadius="10"
                        Margin="0,0,0,10"
                        Padding="15">

                    <TextBlock
                        x:Name="txtPaso5"
                        Text="5 · Procedimientos"
                        FontWeight="SemiBold"
                        FontSize="14"/>     
                </Border>

                <Border x:Name="Paso6Card"
                        Background="White"
                        BorderBrush="#D1D5DB"
                        BorderThickness="1"
                        CornerRadius="10"
                        Margin="0,0,0,10"
                        Padding="15">

                    <TextBlock
                        x:Name="txtPaso6"
                        Text="6 · Destino"
                        FontWeight="SemiBold"
                        FontSize="14"/>

                </Border>

                <Border x:Name="Paso7Card"
                        Background="White"
                        BorderBrush="#D1D5DB"
                        BorderThickness="1"
                        CornerRadius="10"
                        Padding="15">

                    <TextBlock
                        x:Name="txtPaso7"
                        Text="7 · Resumen"
                        FontWeight="SemiBold"
                        FontSize="14"/>

                </Border>

            </StackPanel>
        </Border>

        <Border Grid.Row="1"
                Grid.Column="2"
                Background="White"
                CornerRadius="15"
                Padding="25">

            <ContentControl
        x:Name="contenedorPaso"/>

        </Border>

        <!--========================
                BOTONES
        =========================-->

        <StackPanel
            Grid.Row="2"
            Grid.ColumnSpan="3"
            Orientation="Horizontal"
            HorizontalAlignment="Right">

            <Button
                x:Name="btnCancelar"
                Width="120"
                Height="40"
                Margin="0,0,10,0"
                Content="Cancelar"
                Click="btnCancelar_Click"/>

            <Button
                x:Name="btnSiguiente"
                Width="170"
                Height="40"
                Content="Siguiente ➜"
                Background="#2563EB"
                Foreground="White"
                FontWeight="Bold" Click="btnSiguiente_Click"/>

        </StackPanel>

    </Grid>

</Window>