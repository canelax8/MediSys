<UserControl x:Class="Proyecto_MediSys.Controls.PasoInformacionClinica"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#F6F8FA">

    <UserControl.Resources>

        <!-- =====================================================
                         TÍTULO DE SECCIÓN
        ====================================================== -->

        <Style x:Key="SectionTitleStyle"
               TargetType="TextBlock">

            <Setter Property="FontSize"
                    Value="17"/>

            <Setter Property="FontWeight"
                    Value="SemiBold"/>

            <Setter Property="Foreground"
                    Value="#1E293B"/>

        </Style>


        <!-- =====================================================
                             SUBTÍTULO
        ====================================================== -->

        <Style x:Key="SectionDescriptionStyle"
               TargetType="TextBlock">

            <Setter Property="FontSize"
                    Value="12"/>

            <Setter Property="Foreground"
                    Value="#64748B"/>

            <Setter Property="Margin"
                    Value="0,4,0,14"/>

        </Style>


        <!-- =====================================================
                              LABEL
        ====================================================== -->

        <Style x:Key="LabelStyle"
               TargetType="TextBlock">

            <Setter Property="FontSize"
                    Value="12"/>

            <Setter Property="FontWeight"
                    Value="SemiBold"/>

            <Setter Property="Foreground"
                    Value="#475569"/>

        </Style>


        <!-- =====================================================
                             TEXTBOX
        ====================================================== -->

        <Style x:Key="ClinicalTextBoxStyle"
               TargetType="TextBox">

            <Setter Property="Background"
                    Value="#F8FAFC"/>

            <Setter Property="BorderBrush"
                    Value="#CBD5E1"/>

            <Setter Property="BorderThickness"
                    Value="1"/>

            <Setter Property="Padding"
                    Value="12,8"/>

            <Setter Property="FontSize"
                    Value="13"/>

            <Setter Property="Foreground"
                    Value="#1E293B"/>

            <Setter Property="VerticalContentAlignment"
                    Value="Top"/>

        </Style>


        <!-- =====================================================
                            CHECKBOX
        ====================================================== -->

        <Style x:Key="ClinicalCheckBoxStyle"
               TargetType="CheckBox">

            <Setter Property="FontSize"
                    Value="13"/>

            <Setter Property="Foreground"
                    Value="#334155"/>

            <Setter Property="Margin"
                    Value="0,0,24,12"/>

            <Setter Property="VerticalAlignment"
                    Value="Center"/>

        </Style>

    </UserControl.Resources>


    <Grid Margin="4">

        <Grid.RowDefinitions>

            <RowDefinition Height="Auto"/>

            <RowDefinition Height="*"/>

        </Grid.RowDefinitions>


        <!-- =====================================================
                            ENCABEZADO
        ====================================================== -->

        <Grid Grid.Row="0"
              Margin="0,0,0,18">

            <Grid.ColumnDefinitions>

                <ColumnDefinition/>

                <ColumnDefinition Width="Auto"/>

            </Grid.ColumnDefinitions>


            <StackPanel>

                <TextBlock
                    Text="Información clínica"
                    FontSize="26"
                    FontWeight="Bold"
                    Foreground="#172033"/>

                <TextBlock
                    Margin="0,5,0,0"
                    FontSize="13"
                    Foreground="#64748B"
                    Text="Antecedentes e información clínica relevante del paciente."/>

            </StackPanel>


            <Border Grid.Column="1"
                    Height="34"
                    Padding="14,0"
                    Background="#EAF1FB"
                    CornerRadius="17"
                    VerticalAlignment="Center">

                <TextBlock
                    Text="Paso 3 de 7"
                    FontSize="11"
                    FontWeight="SemiBold"
                    Foreground="#2457A6"
                    VerticalAlignment="Center"/>

            </Border>

        </Grid>


        <!-- =====================================================
                              CONTENIDO
        ====================================================== -->

        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">

            <StackPanel Margin="0,0,8,10">


                <!-- =================================================
                        MOTIVO DE CONSULTA
                ================================================== -->

                <Border Background="White"
                        BorderBrush="#E2E8F0"
                        BorderThickness="1"
                        CornerRadius="10"
                        Padding="18"
                        Margin="0,0,0,14">

                    <StackPanel>

                        <TextBlock
                            Style="{StaticResource SectionTitleStyle}"
                            Text="Motivo de consulta"/>

                        <TextBlock
                            Style="{StaticResource SectionDescriptionStyle}"
                            Text="Describa brevemente la razón principal por la que el paciente acude a emergencia."/>

                        <TextBox
                            x:Name="txtMotivoConsulta"
                            Style="{StaticResource ClinicalTextBoxStyle}"
                            Height="70"
                            AcceptsReturn="True"
                            TextWrapping="Wrap"
                            VerticalScrollBarVisibility="Auto"/>

                    </StackPanel>

                </Border>


                <!-- =================================================
                           ANTECEDENTES
                ================================================== -->

                <Border Background="White"
                        BorderBrush="#E2E8F0"
                        BorderThickness="1"
                        CornerRadius="10"
                        Padding="18"
                        Margin="0,0,0,14">

                    <StackPanel>

                        <Grid>

                            <Grid.ColumnDefinitions>

                                <ColumnDefinition/>

                                <ColumnDefinition Width="Auto"/>

                            </Grid.ColumnDefinitions>


                            <StackPanel>

                                <TextBlock
                                    Style="{StaticResource SectionTitleStyle}"
                                    Text="Antecedentes patológicos"/>

                                <TextBlock
                                    Style="{StaticResource SectionDescriptionStyle}"
                                    Text="Seleccione los antecedentes conocidos del paciente."/>

                            </StackPanel>


                            <Border Grid.Column="1"
                                    Background="#F1F5F9"
                                    CornerRadius="14"
                                    Padding="10,4"
                                    VerticalAlignment="Top">

                                <TextBlock
                                    Text="Selección múltiple"
                                    FontSize="10"
                                    Foreground="#64748B"/>

                            </Border>

                        </Grid>


                        <WrapPanel Margin="0,4,0,0">

                            <CheckBox
                                x:Name="chkDiabetes"
                                Style="{StaticResource ClinicalCheckBoxStyle}"
                                Content="Diabetes"/>

                            <CheckBox
                                x:Name="chkHipertension"
                                Style="{StaticResource ClinicalCheckBoxStyle}"
                                Content="Hipertensión"/>

                            <CheckBox
                                x:Name="chkAsma"
                                Style="{StaticResource ClinicalCheckBoxStyle}"
                                Content="Asma"/>

                            <CheckBox
                                x:Name="chkCardiopatia"
                                Style="{StaticResource ClinicalCheckBoxStyle}"
                                Content="Cardiopatía"/>

                            <CheckBox
                                x:Name="chkEmbarazo"
                                Style="{StaticResource ClinicalCheckBoxStyle}"
                                Content="Embarazo"/>

                            <CheckBox
                                x:Name="chkNinguno"
                                Style="{StaticResource ClinicalCheckBoxStyle}"
                                Content="Sin antecedentes conocidos"/>

                        </WrapPanel>

                    </StackPanel>

                </Border>


                <!-- =================================================
                     ALERGIAS Y MEDICAMENTOS - DOS COLUMNAS
                ================================================== -->

                <Grid Margin="0,0,0,14">

                    <Grid.ColumnDefinitions>

                        <ColumnDefinition/>

                        <ColumnDefinition/>

                    </Grid.ColumnDefinitions>


                    <!-- =========================================================
                        ALERGIAS DEL PACIENTE
========================================================== -->

                    <Border Grid.Column="0"
        Margin="0,0,7,0"
        Background="White"
        BorderBrush="#E2E8F0"
        BorderThickness="1"
        CornerRadius="10"
        Padding="18">

                        <StackPanel>

                            <!-- =============================================
                         ENCABEZADO
        ============================================== -->

                            <Grid Margin="0,0,0,10">

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>


                                <StackPanel>

                                    <TextBlock
                    FontSize="17"
                    FontWeight="SemiBold"
                    Foreground="#1E293B"
                    Text="Alergias conocidas"/>

                                    <TextBlock
                    Margin="0,4,0,0"
                    FontSize="11"
                    Foreground="#64748B"
                    Text="Alergias registradas permanentemente para este paciente."/>

                                </StackPanel>


                                <Border
                Grid.Column="1"
                Background="#F1F5F9"
                CornerRadius="13"
                Padding="9,3"
                VerticalAlignment="Top">

                                    <TextBlock
                    Text="Catálogo"
                    FontSize="10"
                    Foreground="#64748B"/>

                                </Border>

                            </Grid>


                            <!-- =============================================
                        ALERTA
        ============================================== -->

                            <Border
            x:Name="panelAlertaAlergia"
            Visibility="Collapsed"
            Margin="0,0,0,12"
            Padding="12"
            Background="#FFF7ED"
            BorderBrush="#F0B86E"
            BorderThickness="1"
            CornerRadius="8">

                                <Grid>

                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition/>
                                    </Grid.ColumnDefinitions>


                                    <TextBlock
                    Text="!"
                    Width="27"
                    Height="27"
                    Background="#D97706"
                    Foreground="White"
                    FontWeight="Bold"
                    FontSize="14"
                    TextAlignment="Center"
                    VerticalAlignment="Center"/>


                                    <StackPanel
                    Grid.Column="1"
                    Margin="10,0,0,0">

                                        <TextBlock
                        Text="Paciente con alergias registradas"
                        FontSize="12"
                        FontWeight="SemiBold"
                        Foreground="#92400E"/>

                                        <TextBlock
                        x:Name="txtContadorAlergias"
                        Margin="0,2,0,0"
                        Text="0 alergias registradas"
                        FontSize="11"
                        Foreground="#A16207"/>

                                    </StackPanel>

                                </Grid>

                            </Border>


                            <!-- =============================================
                     BUSCAR EN CATÁLOGO
        ============================================== -->

                            <TextBlock
            Text="Buscar en catálogo"
            FontSize="11"
            FontWeight="SemiBold"
            Foreground="#475569"/>


                            <Grid Margin="0,6,0,8">

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition/>
                                    <ColumnDefinition Width="95"/>
                                </Grid.ColumnDefinitions>


                                <TextBox
                x:Name="txtBuscarAlergia"
                Height="36"
                Padding="10,5"
                Background="#F8FAFC"
                BorderBrush="#CBD5E1"
                BorderThickness="1"
                VerticalContentAlignment="Center"
                TextChanged="txtBuscarAlergia_TextChanged"/>


                                <Button
                Grid.Column="1"
                Margin="8,0,0,0"
                Height="36"
                Background="#EAF1FB"
                Foreground="#2457A6"
                BorderThickness="0"
                FontWeight="SemiBold"
                FontSize="11"
                Cursor="Hand"
                Content="+ Agregar"
                Click="btnAgregarAlergiaCatalogo_Click"/>

                            </Grid>


                            <!-- RESULTADOS -->

                            <ListBox
            x:Name="lstResultadosAlergias"
            Height="78"
            BorderBrush="#E2E8F0"
            BorderThickness="1"
            Background="#FAFBFC"
            DisplayMemberPath="Nombre"/>


                            <!-- =============================================
                   ALERGIAS REGISTRADAS
        ============================================== -->

                            <TextBlock
            Margin="0,14,0,6"
            Text="Alergias del paciente"
            FontSize="11"
            FontWeight="SemiBold"
            Foreground="#475569"/>


                            <DataGrid
            x:Name="dgAlergiasPaciente"
            Height="105"
            AutoGenerateColumns="False"
            CanUserAddRows="False"
            IsReadOnly="True"
            HeadersVisibility="Column"
            GridLinesVisibility="Horizontal"
            BorderBrush="#E2E8F0"
            BorderThickness="1"
            FontSize="11">

                                <DataGrid.Columns>

                                    <DataGridTextColumn
                    Header="Alergia"
                    Binding="{Binding AlergiaMostrar}"
                    Width="*"/>


                                    <DataGridTemplateColumn
                    Header=""
                    Width="65">

                                        <DataGridTemplateColumn.CellTemplate>

                                            <DataTemplate>

                                                <Button
                                Width="50"
                                Height="25"
                                Background="#FCEEEE"
                                Foreground="#A94442"
                                BorderThickness="0"
                                FontSize="10"
                                Cursor="Hand"
                                Content="Quitar"
                                Click="btnQuitarAlergia_Click"/>

                                            </DataTemplate>

                                        </DataGridTemplateColumn.CellTemplate>

                                    </DataGridTemplateColumn>

                                </DataGrid.Columns>

                            </DataGrid>


                            <!-- =============================================
                       ALERGIA MANUAL
        ============================================== -->

                            <Border
            Margin="0,14,0,0"
            Padding="12"
            Background="#F8FAFC"
            BorderBrush="#E2E8F0"
            BorderThickness="1"
            CornerRadius="7">

                                <StackPanel>

                                    <TextBlock
                    Text="¿No aparece en el catálogo?"
                    FontSize="11"
                    FontWeight="SemiBold"
                    Foreground="#475569"/>

                                    <TextBlock
                    Margin="0,2,0,7"
                    Text="Puede registrar la alergia manualmente."
                    FontSize="10"
                    Foreground="#94A3B8"/>


                                    <Grid>

                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition/>
                                            <ColumnDefinition Width="95"/>
                                        </Grid.ColumnDefinitions>


                                        <TextBox
                        x:Name="txtAlergiaManual"
                        Height="34"
                        Padding="9,4"
                        Background="White"
                        BorderBrush="#CBD5E1"
                        BorderThickness="1"/>


                                        <Button
                        Grid.Column="1"
                        Margin="8,0,0,0"
                        Height="34"
                        Background="#EEF2F6"
                        Foreground="#475569"
                        BorderThickness="0"
                        FontSize="10"
                        FontWeight="SemiBold"
                        Cursor="Hand"
                        Content="+ Registrar"
                        Click="btnAgregarAlergiaManual_Click"/>

                                    </Grid>

                                </StackPanel>

                            </Border>

                        </StackPanel>

                    </Border>


                    <!-- =====================================================
     COLUMNA DERECHA - MEDICAMENTOS Y OBSERVACIONES
====================================================== -->

                    <StackPanel Grid.Column="1"
            Margin="7,0,0,0">

                        <!-- =============================================
                 MEDICAMENTOS HABITUALES
    ============================================== -->

                        <Border Background="White"
            BorderBrush="#E2E8F0"
            BorderThickness="1"
            CornerRadius="10"
            Padding="18"
            Margin="0,0,0,14">

                            <StackPanel>

                                <Grid>

                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock
                    Style="{StaticResource SectionTitleStyle}"
                    Text="Medicamentos habituales"/>

                                    <Border Grid.Column="1"
                        Background="#F1F5F9"
                        CornerRadius="13"
                        Padding="9,3">

                                        <TextBlock
                        Text="Catálogo"
                        FontSize="10"
                        Foreground="#64748B"/>

                                    </Border>

                                </Grid>

                                <TextBlock
                Style="{StaticResource SectionDescriptionStyle}"
                Text="Medicamentos que el paciente utiliza de manera habitual."/>

                                <TextBox
                x:Name="txtMedicamentos"
                Style="{StaticResource ClinicalTextBoxStyle}"
                Height="95"
                AcceptsReturn="True"
                TextWrapping="Wrap"
                VerticalScrollBarVisibility="Auto"/>

                            </StackPanel>

                        </Border>


                        <!-- =============================================
                  OBSERVACIONES CLÍNICAS
    ============================================== -->

                        <Border Background="White"
            BorderBrush="#E2E8F0"
            BorderThickness="1"
            CornerRadius="10"
            Padding="18">

                            <StackPanel>

                                <TextBlock
                Style="{StaticResource SectionTitleStyle}"
                Text="Observaciones clínicas"/>

                                <TextBlock
                Style="{StaticResource SectionDescriptionStyle}"
                Text="Información adicional relevante obtenida durante la valoración inicial."/>

                                <TextBox
                x:Name="txtObservaciones"
                Style="{StaticResource ClinicalTextBoxStyle}"
                Height="180"
                AcceptsReturn="True"
                TextWrapping="Wrap"
                VerticalScrollBarVisibility="Auto"/>

                            </StackPanel>

                        </Border>

                    </StackPanel>

                </Grid>


                

            </StackPanel>

        </ScrollViewer>

    </Grid>

</UserControl>