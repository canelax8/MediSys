<UserControl x:Class="Proyecto_MediSys.Controls.PasoEvaluacion"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Proyecto_MediSys.Controls"
             Background="#F6F8FA">

    <UserControl.Resources>

        <!-- =====================================================
                             TEXTO DE SECCIÓN
        ====================================================== -->

        <Style x:Key="SectionTitleStyle"
               TargetType="TextBlock">

            <Setter Property="FontSize"
                    Value="17"/>

            <Setter Property="FontWeight"
                    Value="SemiBold"/>

            <Setter Property="Foreground"
                    Value="#1E293B"/>

        </Style>


        <!-- =====================================================
                             ETIQUETA PEQUEÑA
        ====================================================== -->

        <Style x:Key="LabelStyle"
               TargetType="TextBlock">

            <Setter Property="FontSize"
                    Value="11"/>

            <Setter Property="Foreground"
                    Value="#64748B"/>

        </Style>


        <!-- =====================================================
                         VALOR DEL PACIENTE
        ====================================================== -->

        <Style x:Key="PatientValueStyle"
               TargetType="TextBlock">

            <Setter Property="FontSize"
                    Value="14"/>

            <Setter Property="FontWeight"
                    Value="SemiBold"/>

            <Setter Property="Foreground"
                    Value="#1E293B"/>

            <Setter Property="Margin"
                    Value="0,4,0,0"/>

        </Style>

    </UserControl.Resources>


    <Grid Margin="4">

        <Grid.RowDefinitions>

            <RowDefinition Height="Auto"/>

            <RowDefinition Height="*"/>

        </Grid.RowDefinitions>


        <!-- =====================================================
                              ENCABEZADO
        ====================================================== -->

        <Grid Grid.Row="0"
              Margin="0,0,0,18">

            <Grid.ColumnDefinitions>

                <ColumnDefinition/>

                <ColumnDefinition Width="Auto"/>

            </Grid.ColumnDefinitions>


            <StackPanel>

                <TextBlock
                    Text="Evaluación inicial"
                    FontSize="26"
                    FontWeight="Bold"
                    Foreground="#172033"/>

                <TextBlock
                    Margin="0,5,0,0"
                    FontSize="13"
                    Foreground="#64748B"
                    Text="Registro de triage y signos vitales del paciente."/>

            </StackPanel>


            <Border Grid.Column="1"
                    Height="34"
                    Padding="14,0"
                    Background="#EAF1FB"
                    CornerRadius="17"
                    VerticalAlignment="Center">

                <TextBlock
                    Text="Paso 2 de 7"
                    FontSize="11"
                    FontWeight="SemiBold"
                    Foreground="#2457A6"
                    VerticalAlignment="Center"/>

            </Border>

        </Grid>


        <!-- =====================================================
                             CONTENIDO
        ====================================================== -->

        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">

            <StackPanel Margin="0,0,8,10">


                <!-- =================================================
                              DATOS DEL PACIENTE
                ================================================== -->

                <Border Background="White"
                        BorderBrush="#E2E8F0"
                        BorderThickness="1"
                        CornerRadius="10"
                        Padding="18"
                        Margin="0,0,0,14">

                    <StackPanel>

                        <Grid Margin="0,0,0,16">

                            <Grid.ColumnDefinitions>

                                <ColumnDefinition/>

                                <ColumnDefinition Width="Auto"/>

                            </Grid.ColumnDefinitions>

                            <TextBlock
                                Style="{StaticResource SectionTitleStyle}"
                                Text="Paciente"/>

                            <TextBlock
                                Grid.Column="1"
                                Text="Información de identificación"
                                FontSize="11"
                                Foreground="#94A3B8"
                                VerticalAlignment="Center"/>

                        </Grid>


                        <Grid>

                            <Grid.ColumnDefinitions>

                                <ColumnDefinition Width="2*"/>

                                <ColumnDefinition Width="1.5*"/>

                                <ColumnDefinition/>

                                <ColumnDefinition Width="1.5*"/>

                            </Grid.ColumnDefinitions>


                            <!-- NOMBRE -->

                            <StackPanel Grid.Column="0"
                                        Margin="0,0,20,0">

                                <TextBlock
                                    Style="{StaticResource LabelStyle}"
                                    Text="Nombre completo"/>

                                <TextBlock
                                    x:Name="txtNombrePaciente"
                                    Style="{StaticResource PatientValueStyle}"
                                    TextWrapping="Wrap"/>

                            </StackPanel>


                            <!-- DOCUMENTO -->

                            <StackPanel Grid.Column="1"
                                        Margin="0,0,20,0">

                                <TextBlock
                                    Style="{StaticResource LabelStyle}"
                                    Text="Documento"/>

                                <TextBlock
                                    x:Name="txtDocumento"
                                    Style="{StaticResource PatientValueStyle}"/>

                            </StackPanel>


                            <!-- EDAD -->

                            <StackPanel Grid.Column="2"
                                        Margin="0,0,20,0">

                                <TextBlock
                                    Style="{StaticResource LabelStyle}"
                                    Text="Edad"/>

                                <TextBlock
                                    x:Name="txtEdad"
                                    Style="{StaticResource PatientValueStyle}"/>

                            </StackPanel>


                            <!-- SEGURO -->

                            <StackPanel Grid.Column="3">

                                <TextBlock
                                    Style="{StaticResource LabelStyle}"
                                    Text="Seguro"/>

                                <TextBlock
                                    x:Name="txtSeguro"
                                    Style="{StaticResource PatientValueStyle}"
                                    TextWrapping="Wrap"/>

                            </StackPanel>

                        </Grid>

                    </StackPanel>

                </Border>


                <!-- =================================================
                                  TRIAGE
                ================================================== -->

                <Border Background="White"
                        BorderBrush="#E2E8F0"
                        BorderThickness="1"
                        CornerRadius="10"
                        Padding="18"
                        Margin="0,0,0,14">

                    <StackPanel>


                        <!-- TÍTULO -->

                        <TextBlock
                            Style="{StaticResource SectionTitleStyle}"
                            Text="Clasificación de triage"/>

                        <TextBlock
                            Margin="0,4,0,18"
                            FontSize="12"
                            Foreground="#64748B"
                            Text="Seleccione el nivel de prioridad clínica del paciente."/>


                        <!-- =================================================
                                   TARJETAS TRIAGE
                        ================================================== -->

                        <UniformGrid Columns="5"
                                     Margin="0,0,0,16">


                            <!-- TRIAGE I -->

                            <Border
                                x:Name="cardTriage1"
                                Height="84"
                                Margin="4"
                                Background="#FFF3F3"
                                BorderBrush="#D66A6A"
                                BorderThickness="1"
                                CornerRadius="8"
                                Cursor="Hand"
                                MouseLeftButtonDown="cardTriage1_MouseLeftButtonDown">

                                <Grid Margin="12,9">

                                    <Grid.ColumnDefinitions>

                                        <ColumnDefinition Width="34"/>

                                        <ColumnDefinition/>

                                    </Grid.ColumnDefinitions>


                                    <Border
                                        Width="30"
                                        Height="30"
                                        CornerRadius="15"
                                        Background="#C94D4D"
                                        VerticalAlignment="Center">

                                        <TextBlock
                                            Text="I"
                                            Foreground="White"
                                            FontWeight="Bold"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"/>

                                    </Border>


                                    <StackPanel
                                        Grid.Column="1"
                                        Margin="9,0,0,0"
                                        VerticalAlignment="Center">

                                        <TextBlock
                                            Text="Reanimación"
                                            FontSize="12"
                                            FontWeight="SemiBold"
                                            Foreground="#7F1D1D"/>

                                        <TextBlock
                                            Text="Prioridad máxima"
                                            Margin="0,2,0,0"
                                            FontSize="10"
                                            Foreground="#9F5F5F"/>

                                    </StackPanel>

                                </Grid>

                            </Border>


                            <!-- TRIAGE II -->

                            <Border
                                x:Name="cardTriage2"
                                Height="84"
                                Margin="4"
                                Background="#FFF7ED"
                                BorderBrush="#D9904C"
                                BorderThickness="1"
                                CornerRadius="8"
                                Cursor="Hand"
                                MouseLeftButtonDown="cardTriage2_MouseLeftButtonDown">

                                <Grid Margin="12,9">

                                    <Grid.ColumnDefinitions>

                                        <ColumnDefinition Width="34"/>

                                        <ColumnDefinition/>

                                    </Grid.ColumnDefinitions>


                                    <Border
                                        Width="30"
                                        Height="30"
                                        CornerRadius="15"
                                        Background="#D9772D"
                                        VerticalAlignment="Center">

                                        <TextBlock
                                            Text="II"
                                            Foreground="White"
                                            FontWeight="Bold"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"/>

                                    </Border>


                                    <StackPanel
                                        Grid.Column="1"
                                        Margin="9,0,0,0"
                                        VerticalAlignment="Center">

                                        <TextBlock
                                            Text="Emergencia"
                                            FontSize="12"
                                            FontWeight="SemiBold"
                                            Foreground="#8A4514"/>

                                        <TextBlock
                                            Text="Muy urgente"
                                            Margin="0,2,0,0"
                                            FontSize="10"
                                            Foreground="#A66A3E"/>

                                    </StackPanel>

                                </Grid>

                            </Border>


                            <!-- TRIAGE III -->

                            <Border
                                x:Name="cardTriage3"
                                Height="84"
                                Margin="4"
                                Background="#FFFBEA"
                                BorderBrush="#D3B64D"
                                BorderThickness="1"
                                CornerRadius="8"
                                Cursor="Hand"
                                MouseLeftButtonDown="cardTriage3_MouseLeftButtonDown">

                                <Grid Margin="12,9">

                                    <Grid.ColumnDefinitions>

                                        <ColumnDefinition Width="34"/>

                                        <ColumnDefinition/>

                                    </Grid.ColumnDefinitions>


                                    <Border
                                        Width="30"
                                        Height="30"
                                        CornerRadius="15"
                                        Background="#C5A72D"
                                        VerticalAlignment="Center">

                                        <TextBlock
                                            Text="III"
                                            Foreground="White"
                                            FontWeight="Bold"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"/>

                                    </Border>


                                    <StackPanel
                                        Grid.Column="1"
                                        Margin="9,0,0,0"
                                        VerticalAlignment="Center">

                                        <TextBlock
                                            Text="Urgencia"
                                            FontSize="12"
                                            FontWeight="SemiBold"
                                            Foreground="#6E5C13"/>

                                        <TextBlock
                                            Text="Atención prioritaria"
                                            Margin="0,2,0,0"
                                            FontSize="10"
                                            Foreground="#8E7B35"/>

                                    </StackPanel>

                                </Grid>

                            </Border>


                            <!-- TRIAGE IV -->

                            <Border
                                x:Name="cardTriage4"
                                Height="84"
                                Margin="4"
                                Background="#F0FAF4"
                                BorderBrush="#6CAA80"
                                BorderThickness="1"
                                CornerRadius="8"
                                Cursor="Hand"
                                MouseLeftButtonDown="cardTriage4_MouseLeftButtonDown">

                                <Grid Margin="12,9">

                                    <Grid.ColumnDefinitions>

                                        <ColumnDefinition Width="34"/>

                                        <ColumnDefinition/>

                                    </Grid.ColumnDefinitions>


                                    <Border
                                        Width="30"
                                        Height="30"
                                        CornerRadius="15"
                                        Background="#4B9063"
                                        VerticalAlignment="Center">

                                        <TextBlock
                                            Text="IV"
                                            Foreground="White"
                                            FontWeight="Bold"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"/>

                                    </Border>


                                    <StackPanel
                                        Grid.Column="1"
                                        Margin="9,0,0,0"
                                        VerticalAlignment="Center">

                                        <TextBlock
                                            Text="Menor urgencia"
                                            FontSize="12"
                                            FontWeight="SemiBold"
                                            Foreground="#2F6844"/>

                                        <TextBlock
                                            Text="Prioridad baja"
                                            Margin="0,2,0,0"
                                            FontSize="10"
                                            Foreground="#5D816A"/>

                                    </StackPanel>

                                </Grid>

                            </Border>


                            <!-- TRIAGE V -->

                            <Border
                                x:Name="cardTriage5"
                                Height="84"
                                Margin="4"
                                Background="#EFF5FC"
                                BorderBrush="#6F95C4"
                                BorderThickness="1"
                                CornerRadius="8"
                                Cursor="Hand"
                                MouseLeftButtonDown="cardTriage5_MouseLeftButtonDown">

                                <Grid Margin="12,9">

                                    <Grid.ColumnDefinitions>

                                        <ColumnDefinition Width="34"/>

                                        <ColumnDefinition/>

                                    </Grid.ColumnDefinitions>


                                    <Border
                                        Width="30"
                                        Height="30"
                                        CornerRadius="15"
                                        Background="#527DB4"
                                        VerticalAlignment="Center">

                                        <TextBlock
                                            Text="V"
                                            Foreground="White"
                                            FontWeight="Bold"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"/>

                                    </Border>


                                    <StackPanel
                                        Grid.Column="1"
                                        Margin="9,0,0,0"
                                        VerticalAlignment="Center">

                                        <TextBlock
                                            Text="No urgente"
                                            FontSize="12"
                                            FontWeight="SemiBold"
                                            Foreground="#315D91"/>

                                        <TextBlock
                                            Text="Atención diferible"
                                            Margin="0,2,0,0"
                                            FontSize="10"
                                            Foreground="#6680A0"/>

                                    </StackPanel>

                                </Grid>

                            </Border>

                        </UniformGrid>


                        <!-- =================================================
                                TRIAGE SELECCIONADO
                        ================================================== -->

                        <Border Background="#F5F7FA"
                                BorderBrush="#E2E8F0"
                                BorderThickness="1"
                                CornerRadius="7"
                                Padding="12">

                            <StackPanel Orientation="Horizontal">

                                <TextBlock
                                    Text="Prioridad seleccionada:"
                                    FontSize="12"
                                    FontWeight="SemiBold"
                                    Foreground="#475569"/>

                                <TextBlock
                                    x:Name="txtTriageSeleccionado"
                                    Margin="6,0,0,0"
                                    Text="Ninguna"
                                    FontSize="12"
                                    FontWeight="SemiBold"
                                    Foreground="#2457A6"/>

                            </StackPanel>

                        </Border>

                    </StackPanel>

                </Border>


                <!-- =================================================
                              SIGNOS VITALES
                ================================================== -->

                <Border Background="White"
                        BorderBrush="#E2E8F0"
                        BorderThickness="1"
                        CornerRadius="10"
                        Padding="18">

                    <StackPanel>


                        <Grid Margin="0,0,0,16">

                            <Grid.ColumnDefinitions>

                                <ColumnDefinition/>

                                <ColumnDefinition Width="Auto"/>

                            </Grid.ColumnDefinitions>


                            <StackPanel>

                                <TextBlock
                                    Style="{StaticResource SectionTitleStyle}"
                                    Text="Signos vitales"/>

                                <TextBlock
                                    Margin="0,4,0,0"
                                    FontSize="12"
                                    Foreground="#64748B"
                                    Text="Registre los valores obtenidos durante la evaluación inicial."/>

                            </StackPanel>


                            <TextBlock
                                Grid.Column="1"
                                Text="Campos clínicos"
                                FontSize="11"
                                Foreground="#94A3B8"
                                VerticalAlignment="Center"/>

                        </Grid>


                        <!-- =================================================
                                 TARJETAS SIGNOS VITALES
                        ================================================== -->

                        <UniformGrid
                            x:Name="panelSignosVitales"
                            Columns="4"
                            Margin="-4">

                            <controls:VitalSignCard
                                x:Name="cardTemperatura"/>

                            <controls:VitalSignCard
                                x:Name="cardPresion"/>

                            <controls:VitalSignCard
                                x:Name="cardFrecuenciaCardiaca"/>

                            <controls:VitalSignCard
                                x:Name="cardFrecuenciaRespiratoria"/>

                            <controls:VitalSignCard
                                x:Name="cardSaturacion"/>

                            <controls:VitalSignCard
                                x:Name="cardGlucemia"/>

                            <controls:VitalSignCard
                                x:Name="cardPeso"/>

                            <controls:VitalSignCard
                                x:Name="cardTalla"/>

                        </UniformGrid>

                    </StackPanel>

                </Border>

            </StackPanel>

        </ScrollViewer>

    </Grid>

</UserControl>