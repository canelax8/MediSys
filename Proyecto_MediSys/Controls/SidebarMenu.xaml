<UserControl x:Class="Proyecto_MediSys.Controls.SidebarMenu"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             Background="#14233B">


    <!-- =========================================================
                            RECURSOS
    ========================================================== -->

    <UserControl.Resources>


        <!-- =====================================================
                    BOTONES PRINCIPALES DEL MENÚ
        ====================================================== -->

        <Style x:Key="SidebarButtonStyle"
               TargetType="Button">

            <Setter Property="Height"
                    Value="44"/>

            <Setter Property="Margin"
                    Value="12,3"/>

            <Setter Property="Padding"
                    Value="13,0"/>

            <Setter Property="Background"
                    Value="Transparent"/>

            <Setter Property="Foreground"
                    Value="#D7E0ED"/>

            <Setter Property="BorderThickness"
                    Value="0"/>

            <Setter Property="FontSize"
                    Value="12.5"/>

            <Setter Property="FontWeight"
                    Value="SemiBold"/>

            <Setter Property="Cursor"
                    Value="Hand"/>

            <Setter Property="HorizontalContentAlignment"
                    Value="Left"/>


            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="Button">

                        <Border
                            x:Name="ButtonBorder"
                            Background="{TemplateBinding Background}"
                            CornerRadius="7"
                            Padding="{TemplateBinding Padding}">

                            <ContentPresenter
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"/>

                        </Border>


                        <ControlTemplate.Triggers>


                            <!-- HOVER -->

                            <Trigger Property="IsMouseOver"
                                     Value="True">

                                <Setter
                                    TargetName="ButtonBorder"
                                    Property="Background"
                                    Value="#1E3659"/>

                                <Setter
                                    Property="Foreground"
                                    Value="White"/>

                            </Trigger>


                            <!-- CLICK -->

                            <Trigger Property="IsPressed"
                                     Value="True">

                                <Setter
                                    TargetName="ButtonBorder"
                                    Property="Background"
                                    Value="#2563EB"/>

                                <Setter
                                    Property="Foreground"
                                    Value="White"/>

                            </Trigger>


                            <!-- DESHABILITADO -->

                            <Trigger Property="IsEnabled"
                                     Value="False">

                                <Setter
                                    TargetName="ButtonBorder"
                                    Property="Opacity"
                                    Value="0.40"/>

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>


        <!-- =====================================================
                       SUBMENÚ
        ====================================================== -->

        <Style x:Key="SubMenuButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource SidebarButtonStyle}">

            <Setter Property="Height"
                    Value="40"/>

            <Setter Property="Margin"
                    Value="24,2,12,2"/>

            <Setter Property="Padding"
                    Value="11,0"/>

            <Setter Property="FontSize"
                    Value="12"/>

            <Setter Property="FontWeight"
                    Value="Normal"/>

            <Setter Property="Foreground"
                    Value="#BEC9D9"/>

        </Style>


        <!-- =====================================================
             ENCABEZADOS DESPLEGABLES
====================================================== -->

        <Style x:Key="SectionToggleStyle"
       TargetType="ToggleButton">

            <Setter Property="Height"
            Value="43"/>

            <Setter Property="Margin"
            Value="12,5,12,2"/>

            <Setter Property="Padding"
            Value="13,0"/>

            <Setter Property="Background"
            Value="Transparent"/>

            <Setter Property="Foreground"
            Value="#AEBBCD"/>

            <Setter Property="BorderThickness"
            Value="0"/>

            <Setter Property="FontSize"
            Value="11"/>

            <Setter Property="FontWeight"
            Value="SemiBold"/>

            <Setter Property="Cursor"
            Value="Hand"/>

            <Setter Property="HorizontalContentAlignment"
            Value="Stretch"/>


            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="ToggleButton">

                        <Border
                    x:Name="HeaderBorder"
                    Background="{TemplateBinding Background}"
                    CornerRadius="7"
                    Padding="{TemplateBinding Padding}">

                            <Grid>

                                <Grid.ColumnDefinitions>

                                    <ColumnDefinition Width="*"/>

                                    <ColumnDefinition Width="Auto"/>

                                </Grid.ColumnDefinitions>


                                <!-- CONTENIDO -->

                                <ContentPresenter
                            Grid.Column="0"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"/>


                                <!-- FLECHA -->

                                <materialDesign:PackIcon
                            x:Name="ArrowIcon"
                            Grid.Column="1"
                            Kind="ChevronRight"
                            Width="18"
                            Height="18"
                            Foreground="#718096"
                            VerticalAlignment="Center"
                            Margin="8,0,0,0"/>

                            </Grid>

                        </Border>


                        <ControlTemplate.Triggers>


                            <!-- =====================================
                             HOVER
                    ====================================== -->

                            <Trigger Property="IsMouseOver"
                             Value="True">

                                <Setter
                            TargetName="HeaderBorder"
                            Property="Background"
                            Value="#1B304F"/>

                                <Setter
                            Property="Foreground"
                            Value="White"/>

                                <Setter
                            TargetName="ArrowIcon"
                            Property="Foreground"
                            Value="#60A5FA"/>

                            </Trigger>


                            <!-- =====================================
                           SECCIÓN ABIERTA
                    ====================================== -->

                            <Trigger Property="IsChecked"
                             Value="True">

                                <Setter
                            TargetName="HeaderBorder"
                            Property="Background"
                            Value="#192E4D"/>

                                <Setter
                            Property="Foreground"
                            Value="White"/>

                                <Setter
                            TargetName="ArrowIcon"
                            Property="Kind"
                            Value="ChevronDown"/>

                                <Setter
                            TargetName="ArrowIcon"
                            Property="Foreground"
                            Value="#60A5FA"/>

                            </Trigger>


                            <!-- =====================================
                         SECCIÓN CERRADA
                    ====================================== -->

                            <Trigger Property="IsChecked"
                             Value="False">

                                <Setter
                            TargetName="ArrowIcon"
                            Property="Kind"
                            Value="ChevronRight"/>

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>


        <!-- =====================================================
                         CERRAR SESIÓN
        ====================================================== -->

        <Style x:Key="LogoutButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource SidebarButtonStyle}">

            <Setter Property="Background"
                    Value="#3B2134"/>

            <Setter Property="Foreground"
                    Value="#FDA4AF"/>

            <Setter Property="Height"
                    Value="46"/>

        </Style>

    </UserControl.Resources>



    <!-- =========================================================
                         ESTRUCTURA PRINCIPAL
    ========================================================== -->

    <Grid Background="#14233B">

        <Grid.RowDefinitions>

            <!-- CABECERA -->
            <RowDefinition Height="Auto"/>

            <!-- NAVEGACIÓN -->
            <RowDefinition Height="*"/>

            <!-- PIE -->
            <RowDefinition Height="Auto"/>

        </Grid.RowDefinitions>


        <!-- =====================================================
                           CABECERA
        ====================================================== -->

        <Border
            Grid.Row="0"
            Margin="16,16,16,8"
            Padding="6,0,6,14"
            BorderBrush="#263B59"
            BorderThickness="0,0,0,1">

            <StackPanel>

                <TextBlock
                    Text="NAVEGACIÓN"
                    FontSize="9"
                    FontWeight="Bold"
                    Foreground="#64748B"
                    Margin="4,0,0,4"/>

                <TextBlock
                    Text="Menú principal"
                    FontSize="18"
                    FontWeight="SemiBold"
                    Foreground="White"
                    Margin="4,0,0,0"/>

            </StackPanel>

        </Border>



        <!-- =====================================================
                            NAVEGACIÓN
        ====================================================== -->

        <ScrollViewer
            Grid.Row="1"
            VerticalScrollBarVisibility="Auto"
            HorizontalScrollBarVisibility="Disabled">

            <StackPanel Margin="0,2,0,14">


                <!-- =================================================
                             DASHBOARD
                ================================================== -->

                <Button
                    x:Name="btnDashboard"
                    Style="{StaticResource SidebarButtonStyle}"
                    Click="btnDashboard_Click">

                    <StackPanel Orientation="Horizontal">

                        <materialDesign:PackIcon
                            Kind="ViewDashboard"
                            Width="20"
                            Height="20"
                            Foreground="#60A5FA"
                            VerticalAlignment="Center"
                            Margin="0,0,12,0"/>

                        <TextBlock
                            Text="Dashboard"
                            VerticalAlignment="Center"/>

                    </StackPanel>

                </Button>



                <!-- =================================================
                           MANTENIMIENTO
                ================================================== -->

                <ToggleButton
                    x:Name="tglMantenimiento"
                    Style="{StaticResource SectionToggleStyle}">

                    <StackPanel Orientation="Horizontal">

                        <materialDesign:PackIcon
                            Kind="Wrench"
                            Width="19"
                            Height="19"
                            Foreground="#60A5FA"
                            VerticalAlignment="Center"
                            Margin="0,0,12,0"/>

                        <TextBlock
                            Text="MANTENIMIENTO"
                            VerticalAlignment="Center"/>

                    </StackPanel>

                </ToggleButton>


                <!-- CONTENIDO MANTENIMIENTO -->

                <StackPanel>

                    <StackPanel.Style>

                        <Style TargetType="StackPanel">

                            <Setter Property="Visibility"
                                    Value="Collapsed"/>

                            <Style.Triggers>

                                <DataTrigger
                                    Binding="{Binding IsChecked,
                                              ElementName=tglMantenimiento}"
                                    Value="True">

                                    <Setter Property="Visibility"
                                            Value="Visible"/>

                                </DataTrigger>

                            </Style.Triggers>

                        </Style>

                    </StackPanel.Style>


                    <!-- USUARIOS -->

                    <Button
                        x:Name="btnUsuarios"
                        Style="{StaticResource SubMenuButtonStyle}"
                        Click="btnUsuarios_Click">

                        <StackPanel Orientation="Horizontal">

                            <materialDesign:PackIcon
                                Kind="Account"
                                Width="18"
                                Height="18"
                                Foreground="#94A3B8"
                                Margin="0,0,11,0"/>

                            <TextBlock Text="Usuarios"/>

                        </StackPanel>

                    </Button>


                    <!-- PACIENTES -->

                    <Button
                        x:Name="btnPacientes"
                        Style="{StaticResource SubMenuButtonStyle}"
                        Click="btnPacientes_Click">

                        <StackPanel Orientation="Horizontal">

                            <materialDesign:PackIcon
                                Kind="AccountMultiple"
                                Width="18"
                                Height="18"
                                Foreground="#94A3B8"
                                Margin="0,0,11,0"/>

                            <TextBlock Text="Pacientes"/>

                        </StackPanel>

                    </Button>


                    <!-- MÉDICOS -->

                    <Button
                        x:Name="btnMedicos"
                        Style="{StaticResource SubMenuButtonStyle}"
                        Click="btnMedicos_Click">

                        <StackPanel Orientation="Horizontal">

                            <materialDesign:PackIcon
                                Kind="Account"
                                Width="18"
                                Height="18"
                                Foreground="#94A3B8"
                                Margin="0,0,11,0"/>

                            <TextBlock Text="Médicos"/>

                        </StackPanel>

                    </Button>


                    <!-- ESPECIALIDADES -->

                    <Button
                        x:Name="btnEspecialidades"
                        Style="{StaticResource SubMenuButtonStyle}"
                        Click="btnEspecialidades_Click">

                        <StackPanel Orientation="Horizontal">

                            <materialDesign:PackIcon
                                Kind="Tag"
                                Width="18"
                                Height="18"
                                Foreground="#94A3B8"
                                Margin="0,0,11,0"/>

                            <TextBlock Text="Especialidades"/>

                        </StackPanel>

                    </Button>


                    <!-- MEDICAMENTOS -->

                    <Button
                        x:Name="btnMedicamentos"
                        Style="{StaticResource SubMenuButtonStyle}"
                        Click="btnMedicamentos_Click">

                        <StackPanel Orientation="Horizontal">

                            <materialDesign:PackIcon
                                Kind="Pill"
                                Width="18"
                                Height="18"
                                Foreground="#94A3B8"
                                Margin="0,0,11,0"/>

                            <TextBlock Text="Medicamentos"/>

                        </StackPanel>

                    </Button>

                </StackPanel>



                <!-- =================================================
                              PROCESOS
                ================================================== -->

                <ToggleButton
                    x:Name="tglProcesos"
                    IsChecked="True"
                    Style="{StaticResource SectionToggleStyle}">

                    <StackPanel Orientation="Horizontal">

                        <materialDesign:PackIcon
                            Kind="ClipboardText"
                            Width="19"
                            Height="19"
                            Foreground="#60A5FA"
                            Margin="0,0,12,0"/>

                        <TextBlock
                            Text="PROCESOS"
                            VerticalAlignment="Center"/>

                    </StackPanel>

                </ToggleButton>


                <!-- CONTENIDO PROCESOS -->

                <StackPanel>

                    <StackPanel.Style>

                        <Style TargetType="StackPanel">

                            <Setter Property="Visibility"
                                    Value="Collapsed"/>

                            <Style.Triggers>

                                <DataTrigger
                                    Binding="{Binding IsChecked,
                                              ElementName=tglProcesos}"
                                    Value="True">

                                    <Setter Property="Visibility"
                                            Value="Visible"/>

                                </DataTrigger>

                            </Style.Triggers>

                        </Style>

                    </StackPanel.Style>


                    <!-- EMERGENCIAS -->

                    <Button
                        x:Name="btnEmergencias"
                        Style="{StaticResource SubMenuButtonStyle}"
                        Click="btnEmergencias_Click">

                        <StackPanel Orientation="Horizontal">

                            <materialDesign:PackIcon
                                Kind="Alert"
                                Width="18"
                                Height="18"
                                Foreground="#F59E0B"
                                Margin="0,0,11,0"/>

                            <TextBlock Text="Emergencias"/>

                        </StackPanel>

                    </Button>


                    <!-- CITAS -->

                    <Button
                        x:Name="btnCitas"
                        Style="{StaticResource SubMenuButtonStyle}"
                        Click="btnCitas_Click">

                        <StackPanel Orientation="Horizontal">

                            <materialDesign:PackIcon
                                Kind="Calendar"
                                Width="18"
                                Height="18"
                                Foreground="#60A5FA"
                                Margin="0,0,11,0"/>

                            <TextBlock Text="Citas"/>

                        </StackPanel>

                    </Button>


                    <!-- INTERNAMIENTOS -->

                    <Button
                        x:Name="btnInternamientos"
                        Style="{StaticResource SubMenuButtonStyle}"
                        Click="btnInternamientos_Click">

                        <StackPanel Orientation="Horizontal">

                            <materialDesign:PackIcon
                                Kind="Bed"
                                Width="18"
                                Height="18"
                                Foreground="#34D399"
                                Margin="0,0,11,0"/>

                            <TextBlock Text="Internamientos"/>

                        </StackPanel>

                    </Button>


                    <!-- FACTURACIÓN -->

                    <Button
                        x:Name="btnFacturacion"
                        Style="{StaticResource SubMenuButtonStyle}"
                        Click="btnFacturacion_Click">

                        <StackPanel Orientation="Horizontal">

                            <materialDesign:PackIcon
                                Kind="Cash"
                                Width="18"
                                Height="18"
                                Foreground="#A78BFA"
                                Margin="0,0,11,0"/>

                            <TextBlock Text="Facturación"/>

                        </StackPanel>

                    </Button>


                    <!-- LABORATORIO -->

                    <Button
                        x:Name="btnLaboratorio"
                        Style="{StaticResource SubMenuButtonStyle}"
                        Click="btnLaboratorio_Click">

                        <StackPanel Orientation="Horizontal">

                            <materialDesign:PackIcon
                                Kind="Flask"
                                Width="18"
                                Height="18"
                                Foreground="#22D3EE"
                                Margin="0,0,11,0"/>

                            <TextBlock Text="Laboratorio"/>

                        </StackPanel>

                    </Button>

                </StackPanel>



                <!-- =================================================
                              CONSULTAS
                ================================================== -->

                <ToggleButton
                    x:Name="tglConsultas"
                    Style="{StaticResource SectionToggleStyle}">

                    <StackPanel Orientation="Horizontal">

                        <materialDesign:PackIcon
                            Kind="Magnify"
                            Width="19"
                            Height="19"
                            Foreground="#60A5FA"
                            Margin="0,0,12,0"/>

                        <TextBlock
                            Text="CONSULTAS"
                            VerticalAlignment="Center"/>

                    </StackPanel>

                </ToggleButton>


                <!-- CONTENIDO CONSULTAS -->

                <StackPanel>

                    <StackPanel.Style>

                        <Style TargetType="StackPanel">

                            <Setter Property="Visibility"
                                    Value="Collapsed"/>

                            <Style.Triggers>

                                <DataTrigger
                                    Binding="{Binding IsChecked,
                                              ElementName=tglConsultas}"
                                    Value="True">

                                    <Setter Property="Visibility"
                                            Value="Visible"/>

                                </DataTrigger>

                            </Style.Triggers>

                        </Style>

                    </StackPanel.Style>


                    <!-- REPORTES -->

                    <Button
                        x:Name="btnReportes"
                        Style="{StaticResource SubMenuButtonStyle}"
                        Click="btnReportes_Click">

                        <StackPanel Orientation="Horizontal">

                            <materialDesign:PackIcon
                                Kind="FileDocument"
                                Width="18"
                                Height="18"
                                Foreground="#94A3B8"
                                Margin="0,0,11,0"/>

                            <TextBlock Text="Reportes"/>

                        </StackPanel>

                    </Button>


                    <!-- BUSCAR PACIENTE -->

                    <Button
                        x:Name="btnBuscarPaciente"
                        Style="{StaticResource SubMenuButtonStyle}"
                        Click="btnBuscarPaciente_Click">

                        <StackPanel Orientation="Horizontal">

                            <materialDesign:PackIcon
                                Kind="Magnify"
                                Width="18"
                                Height="18"
                                Foreground="#94A3B8"
                                Margin="0,0,11,0"/>

                            <TextBlock Text="Buscar paciente"/>

                        </StackPanel>

                    </Button>


                    <!-- ESTADÍSTICAS -->

                    <Button
                        x:Name="btnEstadisticas"
                        Style="{StaticResource SubMenuButtonStyle}"
                        Click="btnEstadisticas_Click">

                        <StackPanel Orientation="Horizontal">

                            <materialDesign:PackIcon
                                Kind="ChartBar"
                                Width="18"
                                Height="18"
                                Foreground="#94A3B8"
                                Margin="0,0,11,0"/>

                            <TextBlock Text="Estadísticas"/>

                        </StackPanel>

                    </Button>

                </StackPanel>


                <!-- =================================================
                              SEPARADOR
                ================================================== -->

                <Border
                    Height="1"
                    Background="#263B59"
                    Margin="18,12,18,8"/>


                <!-- =================================================
                           CONFIGURACIÓN
                ================================================== -->

                <Button
                    x:Name="btnConfiguracion"
                    Style="{StaticResource SidebarButtonStyle}"
                    Click="btnConfiguracion_Click">

                    <StackPanel Orientation="Horizontal">

                        <materialDesign:PackIcon
                            Kind="Cog"
                            Width="19"
                            Height="19"
                            Foreground="#94A3B8"
                            Margin="0,0,12,0"/>

                        <TextBlock
                            Text="Configuración"/>

                    </StackPanel>

                </Button>

            </StackPanel>

        </ScrollViewer>



        <!-- =====================================================
                           PIE DEL SIDEBAR
        ====================================================== -->

        <Border
            Grid.Row="2"
            Margin="14,0,14,14"
            Padding="0,13,0,0"
            BorderBrush="#263B59"
            BorderThickness="0,1,0,0">

            <StackPanel>


                <!-- CERRAR SESIÓN -->

                <Button
                    x:Name="btnCerrarSesion"
                    Style="{StaticResource LogoutButtonStyle}"
                    Click="btnCerrarSesion_Click">

                    <StackPanel Orientation="Horizontal">

                        <materialDesign:PackIcon
                            Kind="Logout"
                            Width="19"
                            Height="19"
                            Foreground="#FDA4AF"
                            Margin="0,0,12,0"/>

                        <TextBlock
                            Text="Cerrar sesión"
                            VerticalAlignment="Center"/>

                    </StackPanel>

                </Button>


                <!-- VERSIÓN -->

                <TextBlock
                    Text="MediSys • Sistema Hospitalario"
                    FontSize="8"
                    Foreground="#50627A"
                    HorizontalAlignment="Center"
                    Margin="0,9,0,0"/>

            </StackPanel>

        </Border>

    </Grid>

</UserControl>