<Window x:Class="Proyecto_MediSys.Controls.CambiarEstadoEmergenciaDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Cambiar estado de emergencia"
        Width="480"
        Height="390"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#F5F7FA">

    <Border Margin="20"
            Background="White"
            CornerRadius="15"
            Padding="25">

        <Grid>

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>


            <!-- TÍTULO -->

            <StackPanel Grid.Row="0"
                        Margin="0,0,0,20">

                <TextBlock Text="🔄 Cambiar estado"
                           FontSize="24"
                           FontWeight="Bold"
                           Foreground="#1E3A8A"/>

                <TextBlock Text="Actualice el estado de atención de la emergencia."
                           Margin="0,5,0,0"
                           Foreground="#64748B"
                           FontSize="13"/>

            </StackPanel>


            <!-- CÓDIGO -->

            <Grid Grid.Row="1"
                  Margin="0,0,0,15">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="130"/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           Text="Emergencia:"
                           FontWeight="SemiBold"
                           Foreground="#475569"/>

                <TextBlock x:Name="txtCodigo"
                           Grid.Column="1"
                           FontWeight="Bold"
                           Foreground="#1E3A8A"/>

            </Grid>


            <!-- PACIENTE -->

            <Grid Grid.Row="2"
                  Margin="0,0,0,20">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="130"/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           Text="Paciente:"
                           FontWeight="SemiBold"
                           Foreground="#475569"/>

                <TextBlock x:Name="txtPaciente"
                           Grid.Column="1"
                           FontWeight="SemiBold"
                           Foreground="#0F172A"
                           TextWrapping="Wrap"/>

            </Grid>


            <!-- ESTADO ACTUAL -->

            <StackPanel Grid.Row="3"
                        Margin="0,0,0,15">

                <TextBlock Text="Estado actual"
                           FontSize="13"
                           FontWeight="SemiBold"
                           Foreground="#64748B"/>

                <Border Margin="0,5,0,0"
                        Background="#FEF3C7"
                        CornerRadius="7"
                        Padding="10">

                    <TextBlock x:Name="txtEstadoActual"
                               FontWeight="Bold"
                               Foreground="#92400E"/>

                </Border>

            </StackPanel>


            <!-- NUEVO ESTADO -->

            <StackPanel Grid.Row="4">

                <TextBlock Text="Nuevo estado"
                           FontSize="13"
                           FontWeight="SemiBold"
                           Foreground="#334155"/>

                <ComboBox x:Name="cmbEstado"
                          Height="42"
                          Margin="0,7,0,0"
                          FontSize="14"
                          Padding="10,5">

                    <ComboBoxItem Tag="1"
                                  Content="Pendiente"/>

                    <ComboBoxItem Tag="2"
                                  Content="En Atención"/>

                    <ComboBoxItem Tag="3"
                                  Content="Observación"/>

                    <ComboBoxItem Tag="4"
                                  Content="Hospitalizado"/>

                    <ComboBoxItem Tag="5"
                                  Content="Alta"/>

                    <ComboBoxItem Tag="6"
                                  Content="Trasladado"/>

                    <ComboBoxItem Tag="7"
                                  Content="Fallecido"/>

                </ComboBox>

            </StackPanel>


            <!-- BOTONES -->

            <StackPanel Grid.Row="5"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Margin="0,25,0,0">

                <Button x:Name="btnCancelar"
                        Content="Cancelar"
                        Width="110"
                        Height="40"
                        Margin="0,0,10,0"
                        Background="#E2E8F0"
                        Foreground="#334155"
                        BorderThickness="0"
                        FontWeight="SemiBold"
                        Click="btnCancelar_Click"/>

                <Button x:Name="btnGuardar"
                        Content="✓ Guardar"
                        Width="120"
                        Height="40"
                        Background="#2563EB"
                        Foreground="White"
                        BorderThickness="0"
                        FontWeight="Bold"
                        Click="btnGuardar_Click"/>

            </StackPanel>

        </Grid>

    </Border>

</Window>