<Window x:Class="Proyecto_MediSys.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Proyecto_MediSys"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        mc:Ignorable="d"
        Title="MediSys Login"
        Height="760"
        Width="450"
        WindowStyle="None"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#F5F7FA">

    <Grid>

        <Grid.RowDefinitions>
            <RowDefinition  Height="0"/>
            <RowDefinition/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="White" MouseLeftButtonDown="Border_MouseLeftButtonDown" Margin="0,0,0,760" Grid.RowSpan="2"/>

        <materialDesign:Card Grid.Row="1"
                Margin="20,20,20,20"
                UniformCornerRadius="15"
                Background="{DynamicResource MaterialDesignPaper}">


            <materialDesign:DialogHost
                x:Name="Dialog"
                CloseOnClickAway="True">

                <StackPanel>

                    <!-- MENU SUPERIOR -->

                    <Grid Margin="15">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="196*"/>
                            <ColumnDefinition Width="123*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="MediSys"
                       FontSize="18"
                       FontWeight="Bold"
                       VerticalAlignment="Center" Grid.ColumnSpan="2"/>

                        <StackPanel Grid.Column="2"
                        Orientation="Horizontal">

                            <Button x:Name="btn_exit"
                        Width="51"
                        Height="35"
                        Margin="10,0,0,0"
                        Content="✕"
                        ToolTip="Cerrar"
                        Click="btn_exit_Click"/>
                        </StackPanel>
                    </Grid>

                    <!-- LOGO -->

                    <materialDesign:PackIcon
                        Kind="HospitalBuilding"
                        Width="90"
                        Height="90"
                        Foreground="#1976D2"
                        HorizontalAlignment="Center"
                        Margin="0,20,0,10"/>

                    <!-- NOMBRE -->

                    <TextBlock Text="MediSys"
                       FontSize="30"
                       FontWeight="Bold"
                       HorizontalAlignment="Center"/>

                    <TextBlock Text="Sistema de Gestión Clínica"
                       FontSize="15"
                       Foreground="Gray"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,25"/>

                    <!-- BIENVENIDA -->

                    <TextBlock Text="Welcome Back!"
                       FontSize="26"
                       FontWeight="Bold"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,5"/>

                    <TextBlock Text="Log in to your existing account"
                       FontSize="15"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,25"/>

                    <!-- USUARIO -->

                    <TextBox
                        x:Name="txtUsuario"
                        Margin="30,0,30,15"
                        Height="40"
                        materialDesign:HintAssist.Hint="Usuario" TextChanged="txtUsuario_TextChanged"/>

                    <!-- CONTRASEÑA -->

                    <PasswordBox
                        x:Name="txtPassword"
                        Margin="30,0,30,10"
                        Height="40"
                        materialDesign:HintAssist.Hint="Password" Password="" />

                    <!-- RECORDAR -->

                    <CheckBox
                        Content="Recordarme"
                        Margin="30,0,0,20"/>
                    <Button
                        x:Name="btnLogin"
                        Content="INICIAR SESIÓN"
                        Height="45"
                        FontSize="16"
                        FontWeight="Bold"
                        Background="#1976D2"
                        Foreground="White" Click="btnLogin_Click"
                        IsDefault="True"/>

                    <!-- LOGIN -->

                    <!-- RECUPERAR -->

                    <TextBlock
                        Text="¿Olvidó su contraseña?"
                        HorizontalAlignment="Center"
                        Cursor="Hand"
                        Foreground="#1976D2"
                        Margin="0,10,0,25"/>

                    <!-- FOOTER -->

                    <Separator Margin="20"/>

                    <TextBlock
                        Text="Versión 1.0.0"
                        HorizontalAlignment="Center"
                        Foreground="Gray"
                        FontSize="12"/>

                    <TextBlock
                        Text="© 2026 MediSys"
                        HorizontalAlignment="Center"
                        Foreground="Gray"
                        FontSize="11"
                        Margin="0,5,0,20"/>

                </StackPanel>

            </materialDesign:DialogHost>

        </materialDesign:Card>

    </Grid>

</Window>