<Page x:Class="Proyecto_MediSys.Pages.Procesos.InternamientosPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="#F4F6F8">

    <Page.Resources>

        <!-- =========================================================
                             BOTÓN PRINCIPAL
        ========================================================== -->

        <Style x:Key="PrimaryButtonStyle"
               TargetType="Button">

            <Setter Property="Height"
                    Value="42"/>

            <Setter Property="MinWidth"
                    Value="175"/>

            <Setter Property="Padding"
                    Value="18,0"/>

            <Setter Property="Background"
                    Value="#2457A6"/>

            <Setter Property="Foreground"
                    Value="White"/>

            <Setter Property="BorderThickness"
                    Value="0"/>

            <Setter Property="FontSize"
                    Value="13"/>

            <Setter Property="FontWeight"
                    Value="SemiBold"/>

            <Setter Property="Cursor"
                    Value="Hand"/>

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="Button">

                        <Border x:Name="Border"
                                Background="{TemplateBinding Background}"
                                CornerRadius="7">

                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Margin="{TemplateBinding Padding}"/>

                        </Border>


                        <ControlTemplate.Triggers>

                            <Trigger Property="IsMouseOver"
                                     Value="True">

                                <Setter TargetName="Border"
                                        Property="Opacity"
                                        Value="0.88"/>

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>


        <!-- =========================================================
                          BOTONES DEL DATAGRID
        ========================================================== -->

        <Style x:Key="GridActionButtonStyle"
               TargetType="Button">

            <Setter Property="Height"
                    Value="32"/>

            <Setter Property="Padding"
                    Value="8,0"/>

            <Setter Property="Margin"
                    Value="3,6"/>

            <Setter Property="VerticalAlignment"
                    Value="Center"/>

            <Setter Property="FontSize"
                    Value="11"/>

            <Setter Property="FontWeight"
                    Value="SemiBold"/>

            <Setter Property="Cursor"
                    Value="Hand"/>

            <Setter Property="BorderThickness"
                    Value="1"/>

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="Button">

                        <Border x:Name="Border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5">

                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Margin="{TemplateBinding Padding}"/>

                        </Border>


                        <ControlTemplate.Triggers>

                            <Trigger Property="IsMouseOver"
                                     Value="True">

                                <Setter TargetName="Border"
                                        Property="Opacity"
                                        Value="0.78"/>

                            </Trigger>


                            <Trigger Property="IsEnabled"
                                     Value="False">

                                <Setter TargetName="Border"
                                        Property="Opacity"
                                        Value="0.40"/>

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>


        <!-- =========================================================
                              FILTROS
        ========================================================== -->

        <Style x:Key="FilterTextBoxStyle"
               TargetType="TextBox">

            <Setter Property="Height"
                    Value="40"/>

            <Setter Property="Padding"
                    Value="12,0"/>

            <Setter Property="VerticalContentAlignment"
                    Value="Center"/>

            <Setter Property="Background"
                    Value="White"/>

            <Setter Property="BorderBrush"
                    Value="#CBD5E1"/>

            <Setter Property="BorderThickness"
                    Value="1"/>

            <Setter Property="FontSize"
                    Value="12"/>

        </Style>


        <Style x:Key="FilterComboStyle"
               TargetType="ComboBox">

            <Setter Property="Height"
                    Value="40"/>

            <Setter Property="Padding"
                    Value="9,0"/>

            <Setter Property="VerticalContentAlignment"
                    Value="Center"/>

            <Setter Property="Background"
                    Value="White"/>

            <Setter Property="BorderBrush"
                    Value="#CBD5E1"/>

            <Setter Property="FontSize"
                    Value="12"/>

        </Style>


        <!-- =========================================================
                           TARJETAS ESTADÍSTICAS
        ========================================================== -->

        <Style x:Key="StatCardStyle"
               TargetType="Border">

            <Setter Property="Height"
                    Value="88"/>

            <Setter Property="Background"
                    Value="White"/>

            <Setter Property="BorderBrush"
                    Value="#E2E8F0"/>

            <Setter Property="BorderThickness"
                    Value="1"/>

            <Setter Property="CornerRadius"
                    Value="10"/>

            <Setter Property="Padding"
                    Value="15"/>

        </Style>


        <!-- =========================================================
                              DATAGRID
        ========================================================== -->

        <Style TargetType="DataGridColumnHeader">

            <Setter Property="Background"
                    Value="#F8FAFC"/>

            <Setter Property="Foreground"
                    Value="#475569"/>

            <Setter Property="FontWeight"
                    Value="SemiBold"/>

            <Setter Property="FontSize"
                    Value="11"/>

            <Setter Property="Height"
                    Value="42"/>

            <Setter Property="Padding"
                    Value="10,0"/>

            <Setter Property="BorderBrush"
                    Value="#E2E8F0"/>

            <Setter Property="BorderThickness"
                    Value="0,0,0,1"/>

        </Style>


        <Style TargetType="DataGridRow">

            <!-- IMPORTANTE:
                 MinHeight en lugar de RowHeight fija,
                 para que los botones nunca se recorten. -->

            <Setter Property="MinHeight"
                    Value="54"/>

            <Setter Property="Background"
                    Value="White"/>

            <Setter Property="BorderBrush"
                    Value="#EEF2F6"/>

            <Setter Property="BorderThickness"
                    Value="0,0,0,1"/>

        </Style>


        <Style TargetType="DataGridCell">

            <Setter Property="BorderThickness"
                    Value="0"/>

            <Setter Property="Padding"
                    Value="9,5"/>

            <Setter Property="VerticalContentAlignment"
                    Value="Center"/>

        </Style>


        <!-- =========================================================
                              ESTADO
        ========================================================== -->

        <Style x:Key="EstadoPillStyle"
               TargetType="Border">

            <Setter Property="Background"
                    Value="#EEF2F6"/>

            <Setter Property="Padding"
                    Value="9,4"/>

            <Setter Property="CornerRadius"
                    Value="10"/>

            <Setter Property="HorizontalAlignment"
                    Value="Center"/>


            <Style.Triggers>

                <DataTrigger Binding="{Binding Estado}"
                             Value="Activo">

                    <Setter Property="Background"
                            Value="#E8F7EF"/>

                </DataTrigger>


                <DataTrigger Binding="{Binding Estado}"
                             Value="Alta médica">

                    <Setter Property="Background"
                            Value="#EAF2FF"/>

                </DataTrigger>


                <DataTrigger Binding="{Binding Estado}"
                             Value="Trasladado">

                    <Setter Property="Background"
                            Value="#FFF4E5"/>

                </DataTrigger>


                <DataTrigger Binding="{Binding Estado}"
                             Value="Cancelado">

                    <Setter Property="Background"
                            Value="#FEECEC"/>

                </DataTrigger>

            </Style.Triggers>

        </Style>


        <Style x:Key="EstadoTextoStyle"
               TargetType="TextBlock">

            <Setter Property="Foreground"
                    Value="#475569"/>

            <Setter Property="FontWeight"
                    Value="SemiBold"/>

            <Setter Property="FontSize"
                    Value="10"/>


            <Style.Triggers>

                <DataTrigger Binding="{Binding Estado}"
                             Value="Activo">

                    <Setter Property="Foreground"
                            Value="#287A4B"/>

                </DataTrigger>


                <DataTrigger Binding="{Binding Estado}"
                             Value="Alta médica">

                    <Setter Property="Foreground"
                            Value="#2457A6"/>

                </DataTrigger>


                <DataTrigger Binding="{Binding Estado}"
                             Value="Trasladado">

                    <Setter Property="Foreground"
                            Value="#A15C00"/>

                </DataTrigger>


                <DataTrigger Binding="{Binding Estado}"
                             Value="Cancelado">

                    <Setter Property="Foreground"
                            Value="#B42318"/>

                </DataTrigger>

            </Style.Triggers>

        </Style>

    </Page.Resources>


    <!-- =============================================================
                              CONTENIDO
    ============================================================== -->

    <Grid Margin="30,24,30,24">

        <Grid.RowDefinitions>

            <RowDefinition Height="Auto"/>

            <RowDefinition Height="Auto"/>

            <RowDefinition Height="Auto"/>

            <RowDefinition Height="*"/>

        </Grid.RowDefinitions>


        <!-- =========================================================
                              ENCABEZADO
        ========================================================== -->

        <Grid Grid.Row="0"
              Margin="0,0,0,20">

            <Grid.ColumnDefinitions>

                <ColumnDefinition/>

                <ColumnDefinition Width="Auto"/>

            </Grid.ColumnDefinitions>


            <StackPanel>

                <TextBlock
                    Text="Internamientos"
                    FontSize="28"
                    FontWeight="Bold"
                    Foreground="#172033"/>

                <TextBlock
                    Text="Gestión de pacientes hospitalizados, habitaciones y camas"
                    Margin="0,5,0,0"
                    FontSize="13"
                    Foreground="#6B7280"/>

            </StackPanel>


            <Button
                x:Name="btnNuevoInternamiento"
                Grid.Column="1"
                Width="190"
                Content="+ Nuevo internamiento"
                Style="{StaticResource PrimaryButtonStyle}"
                Click="btnNuevoInternamiento_Click"/>

        </Grid>


        <!-- =========================================================
                          TARJETAS ESTADÍSTICAS
        ========================================================== -->

        <Grid Grid.Row="1"
              Margin="0,0,0,18">

            <Grid.ColumnDefinitions>

                <ColumnDefinition/>
                <ColumnDefinition/>
                <ColumnDefinition/>
                <ColumnDefinition/>
                <ColumnDefinition/>
                <ColumnDefinition/>

            </Grid.ColumnDefinitions>


            <!-- ACTIVOS -->

            <Border Grid.Column="0"
                    Style="{StaticResource StatCardStyle}"
                    Margin="0,0,6,0">

                <StackPanel VerticalAlignment="Center">

                    <TextBlock
                        Text="Internados activos"
                        FontSize="11"
                        Foreground="#64748B"/>

                    <TextBlock
                        x:Name="txtActivos"
                        Text="0"
                        Margin="0,5,0,0"
                        FontSize="25"
                        FontWeight="Bold"
                        Foreground="#287A4B"/>

                </StackPanel>

            </Border>


            <!-- HOSPITALIZACIÓN -->

            <Border Grid.Column="1"
                    Style="{StaticResource StatCardStyle}"
                    Margin="6,0">

                <StackPanel VerticalAlignment="Center">

                    <TextBlock
                        Text="Hospitalización"
                        FontSize="11"
                        Foreground="#64748B"/>

                    <TextBlock
                        x:Name="txtHospitalizacion"
                        Text="0"
                        Margin="0,5,0,0"
                        FontSize="25"
                        FontWeight="Bold"
                        Foreground="#2457A6"/>

                </StackPanel>

            </Border>


            <!-- UCI -->

            <Border Grid.Column="2"
                    Style="{StaticResource StatCardStyle}"
                    Margin="6,0">

                <StackPanel VerticalAlignment="Center">

                    <TextBlock
                        Text="UCI"
                        FontSize="11"
                        Foreground="#64748B"/>

                    <TextBlock
                        x:Name="txtUci"
                        Text="0"
                        Margin="0,5,0,0"
                        FontSize="25"
                        FontWeight="Bold"
                        Foreground="#B42318"/>

                </StackPanel>

            </Border>


            <!-- ALTAS HOY -->

            <Border Grid.Column="3"
                    Style="{StaticResource StatCardStyle}"
                    Margin="6,0">

                <StackPanel VerticalAlignment="Center">

                    <TextBlock
                        Text="Altas hoy"
                        FontSize="11"
                        Foreground="#64748B"/>

                    <TextBlock
                        x:Name="txtAltasHoy"
                        Text="0"
                        Margin="0,5,0,0"
                        FontSize="25"
                        FontWeight="Bold"
                        Foreground="#7C3AED"/>

                </StackPanel>

            </Border>


            <!-- CAMAS DISPONIBLES -->

            <Border Grid.Column="4"
                    Style="{StaticResource StatCardStyle}"
                    Margin="6,0">

                <StackPanel VerticalAlignment="Center">

                    <TextBlock
                        Text="Camas disponibles"
                        FontSize="11"
                        Foreground="#64748B"/>

                    <TextBlock
                        x:Name="txtCamasDisponibles"
                        Text="0"
                        Margin="0,5,0,0"
                        FontSize="25"
                        FontWeight="Bold"
                        Foreground="#287A4B"/>

                </StackPanel>

            </Border>


            <!-- CAMAS OCUPADAS -->

            <Border Grid.Column="5"
                    Style="{StaticResource StatCardStyle}"
                    Margin="6,0,0,0">

                <StackPanel VerticalAlignment="Center">

                    <TextBlock
                        Text="Camas ocupadas"
                        FontSize="11"
                        Foreground="#64748B"/>

                    <TextBlock
                        x:Name="txtCamasOcupadas"
                        Text="0"
                        Margin="0,5,0,0"
                        FontSize="25"
                        FontWeight="Bold"
                        Foreground="#D97706"/>

                </StackPanel>

            </Border>

        </Grid>


        <!-- =========================================================
                              FILTROS
        ========================================================== -->

        <Border Grid.Row="2"
                Background="White"
                BorderBrush="#E2E8F0"
                BorderThickness="1"
                CornerRadius="10"
                Padding="14"
                Margin="0,0,0,16">

            <Grid>

                <Grid.ColumnDefinitions>

                    <ColumnDefinition Width="2*"/>

                    <ColumnDefinition Width="16"/>

                    <ColumnDefinition Width="220"/>

                    <ColumnDefinition Width="16"/>

                    <ColumnDefinition Width="240"/>

                </Grid.ColumnDefinitions>


                <!-- BUSCAR -->

                <StackPanel Grid.Column="0">

                    <TextBlock
                        Text="Buscar"
                        Margin="0,0,0,5"
                        FontSize="10"
                        FontWeight="SemiBold"
                        Foreground="#64748B"/>

                    <TextBox
                        x:Name="txtBuscar"
                        Style="{StaticResource FilterTextBoxStyle}"
                        ToolTip="Código, paciente, médico, habitación o cama"
                        TextChanged="txtBuscar_TextChanged"/>

                </StackPanel>


                <!-- ESTADO -->

                <StackPanel Grid.Column="2">

                    <TextBlock
                        Text="Estado"
                        Margin="0,0,0,5"
                        FontSize="10"
                        FontWeight="SemiBold"
                        Foreground="#64748B"/>

                    <ComboBox
                        x:Name="cmbEstado"
                        Style="{StaticResource FilterComboStyle}"
                        SelectionChanged="cmbEstado_SelectionChanged"/>

                </StackPanel>


                <!-- ÁREA -->

                <StackPanel Grid.Column="4">

                    <TextBlock
                        Text="Área"
                        Margin="0,0,0,5"
                        FontSize="10"
                        FontWeight="SemiBold"
                        Foreground="#64748B"/>

                    <ComboBox
                        x:Name="cmbArea"
                        Style="{StaticResource FilterComboStyle}"
                        SelectionChanged="cmbArea_SelectionChanged"/>

                </StackPanel>

            </Grid>

        </Border>


        <!-- =========================================================
                          TABLA DE INTERNAMIENTOS
        ========================================================== -->

        <Border Grid.Row="3"
                Background="White"
                BorderBrush="#E2E8F0"
                BorderThickness="1"
                CornerRadius="10">

            <Grid>

                <Grid.RowDefinitions>

                    <RowDefinition Height="*"/>

                    <RowDefinition Height="42"/>

                </Grid.RowDefinitions>


                <DataGrid
                    x:Name="dgInternamientos"
                    Grid.Row="0"
                    AutoGenerateColumns="False"
                    CanUserAddRows="False"
                    CanUserDeleteRows="False"
                    CanUserResizeRows="False"
                    IsReadOnly="True"
                    SelectionMode="Single"
                    SelectionUnit="FullRow"
                    HeadersVisibility="Column"
                    GridLinesVisibility="None"
                    Background="White"
                    BorderThickness="0"
                    MinRowHeight="54"
                    HorizontalGridLinesBrush="#EEF2F6"
                    ScrollViewer.HorizontalScrollBarVisibility="Auto"
                    ScrollViewer.VerticalScrollBarVisibility="Auto">

                    <DataGrid.Columns>


                        <DataGridTextColumn
                            Header="Código"
                            Binding="{Binding CodigoInternamiento}"
                            Width="90"/>

                        <DataGridTextColumn
                            Header="Paciente"
                            Binding="{Binding NombrePaciente}"
                            Width="150"/>

                        <DataGridTextColumn
                            Header="Tipo"
                            Binding="{Binding TipoInternamiento}"
                            Width="100"/>

                        <DataGridTextColumn
                            Header="Área"
                            Binding="{Binding Area}"
                            Width="120"/>

                        <DataGridTextColumn
                            Header="Hab."
                            Binding="{Binding Habitacion}"
                            Width="60"/>

                        <DataGridTextColumn
                            Header="Cama"
                            Binding="{Binding CodigoCama}"
                            Width="65"/>

                        <DataGridTextColumn
                            Header="Médico"
                            Binding="{Binding NombreMedico}"
                            Width="135"/>

                        <DataGridTextColumn
                            Header="Ingreso"
                            Binding="{Binding FechaIngresoMostrar}"
                            Width="125"/>       
                        <!-- FECHA -->

                        <DataGridTextColumn
                            Header="Ingreso"
                            Binding="{Binding FechaIngresoMostrar}"
                            Width="145"/>


                        <DataGridTemplateColumn
                                Header="Estado"
                                Width="95">

                            <DataGridTemplateColumn.CellTemplate>

                                <DataTemplate>

                                    <Border
                                        Style="{StaticResource EstadoPillStyle}">

                                        <TextBlock
                                            Text="{Binding Estado}"
                                            Style="{StaticResource EstadoTextoStyle}"/>

                                    </Border>

                                </DataTemplate>

                            </DataGridTemplateColumn.CellTemplate>

                        </DataGridTemplateColumn>


                        <!-- =================================================
                                          ACCIONES
                        ================================================== -->

                        <DataGridTemplateColumn
    Header="Acciones"
    Width="350">

                            <DataGridTemplateColumn.CellTemplate>

                                <DataTemplate>

                                    <StackPanel
                Orientation="Horizontal"
                VerticalAlignment="Center"
                HorizontalAlignment="Center">


                                        <!-- =========================================
                                                     VER
                                        ========================================== -->

                                        <Button
                    Width="55"
                    Content="Ver"
                    Background="#EEF4FC"
                    BorderBrush="#C5D9F3"
                    Foreground="#2457A6"
                    Style="{StaticResource GridActionButtonStyle}"
                    Click="btnVerInternamiento_Click"/>


                                        <!-- =========================================
                                                     EDITAR
                                        ========================================== -->

                                        <Button
                    Width="62"
                    Content="Editar"
                    Background="#F3F4F6"
                    BorderBrush="#DDE1E7"
                    Foreground="#475569"
                    Click="btnEditarInternamiento_Click">

                                            <Button.Style>

                                                <Style
                            TargetType="Button"
                            BasedOn="{StaticResource GridActionButtonStyle}">

                                                    <Setter
                                Property="IsEnabled"
                                Value="False"/>

                                                    <Style.Triggers>

                                                        <DataTrigger
                                    Binding="{Binding Estado}"
                                    Value="Activo">

                                                            <Setter
                                        Property="IsEnabled"
                                        Value="True"/>

                                                        </DataTrigger>

                                                    </Style.Triggers>

                                                </Style>

                                            </Button.Style>

                                        </Button>


                                        <!-- =========================================
                                                 CAMBIAR CAMA
                                        ========================================== -->

                                        <Button
                    Width="108"
                    Content="Cambiar cama"
                    Background="#FFF6E8"
                    BorderBrush="#F3DFC0"
                    Foreground="#A15C00"
                    Click="btnCambiarCama_Click">

                                            <Button.Style>

                                                <Style
                            TargetType="Button"
                            BasedOn="{StaticResource GridActionButtonStyle}">

                                                    <Setter
                                Property="IsEnabled"
                                Value="False"/>

                                                    <Style.Triggers>

                                                        <DataTrigger
                                    Binding="{Binding Estado}"
                                    Value="Activo">

                                                            <Setter
                                        Property="IsEnabled"
                                        Value="True"/>

                                                        </DataTrigger>

                                                    </Style.Triggers>

                                                </Style>

                                            </Button.Style>

                                        </Button>


                                        <!-- =========================================
                            DAR ALTA
                ========================================== -->

                                        <Button
                    Width="72"
                    Content="Dar alta"
                    Background="#E8F7EF"
                    BorderBrush="#CDE8D7"
                    Foreground="#287A4B"
                    Click="btnDarAlta_Click">

                                            <Button.Style>

                                                <Style
                            TargetType="Button"
                            BasedOn="{StaticResource GridActionButtonStyle}">

                                                    <Setter
                                Property="IsEnabled"
                                Value="False"/>

                                                    <Style.Triggers>

                                                        <DataTrigger
                                    Binding="{Binding Estado}"
                                    Value="Activo">

                                                            <Setter
                                        Property="IsEnabled"
                                        Value="True"/>

                                                        </DataTrigger>

                                                    </Style.Triggers>

                                                </Style>

                                            </Button.Style>

                                        </Button>

                                    </StackPanel>

                                </DataTemplate>

                            </DataGridTemplateColumn.CellTemplate>

                        </DataGridTemplateColumn>

                    </DataGrid.Columns>

                </DataGrid>


                <!-- =================================================
                                  PIE
                ================================================== -->

                <Border
                    Grid.Row="1"
                    BorderBrush="#E2E8F0"
                    BorderThickness="0,1,0,0"
                    Padding="12,0">

                    <Grid>

                        <TextBlock
                            x:Name="txtResultados"
                            Text="0 internamientos"
                            VerticalAlignment="Center"
                            FontSize="11"
                            Foreground="#64748B"/>

                    </Grid>

                </Border>

            </Grid>

        </Border>

    </Grid>

</Page>