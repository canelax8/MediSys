<Page x:Class="Proyecto_MediSys.Pages.Procesos.FacturacionPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="#F4F6F8">

    <Page.Resources>

        <!-- =====================================================
                             BOTÓN PRINCIPAL
        ====================================================== -->

        <Style x:Key="PrimaryButtonStyle"
               TargetType="Button">

            <Setter Property="Height"
                    Value="38"/>

            <Setter Property="Padding"
                    Value="18,0"/>

            <Setter Property="Background"
                    Value="#2563EB"/>

            <Setter Property="Foreground"
                    Value="White"/>

            <Setter Property="BorderThickness"
                    Value="0"/>

            <Setter Property="FontWeight"
                    Value="SemiBold"/>

            <Setter Property="FontSize"
                    Value="12"/>

            <Setter Property="Cursor"
                    Value="Hand"/>

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="Button">

                        <Border
                            Background="{TemplateBinding Background}"
                            CornerRadius="7"
                            Padding="{TemplateBinding Padding}">

                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>

                        </Border>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>


        <!-- =====================================================
                             BOTÓN SECUNDARIO
        ====================================================== -->

        <Style x:Key="SecondaryButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource PrimaryButtonStyle}">

            <Setter Property="Background"
                    Value="#EEF2F7"/>

            <Setter Property="Foreground"
                    Value="#334155"/>

        </Style>


        <!-- =====================================================
                             TARJETAS DE TIPO
        ====================================================== -->

        <Style x:Key="TypeButtonStyle"
               TargetType="Button">

            <Setter Property="Background"
                    Value="White"/>

            <Setter Property="BorderBrush"
                    Value="#E2E8F0"/>

            <Setter Property="BorderThickness"
                    Value="1"/>

            <Setter Property="Cursor"
                    Value="Hand"/>

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="Button">

                        <Border
                            x:Name="Card"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="12"
                            Padding="18">

                            <ContentPresenter/>

                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger
                                Property="IsMouseOver"
                                Value="True">

                                <Setter
                                    TargetName="Card"
                                    Property="BorderBrush"
                                    Value="#93C5FD"/>

                                <Setter
                                    TargetName="Card"
                                    Property="Background"
                                    Value="#F8FAFF"/>

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>


        <!-- =====================================================
                            BOTÓN GRID
        ====================================================== -->

        <Style x:Key="GridActionButtonStyle"
               TargetType="Button">

            <Setter Property="Height"
                    Value="32"/>

            <Setter Property="MinWidth"
                    Value="82"/>

            <Setter Property="Padding"
                    Value="12,0"/>

            <Setter Property="Background"
                    Value="#EFF6FF"/>

            <Setter Property="Foreground"
                    Value="#1D4ED8"/>

            <Setter Property="BorderBrush"
                    Value="#BFDBFE"/>

            <Setter Property="BorderThickness"
                    Value="1"/>

            <Setter Property="FontSize"
                    Value="11"/>

            <Setter Property="FontWeight"
                    Value="SemiBold"/>

            <Setter Property="Cursor"
                    Value="Hand"/>

        </Style>

    </Page.Resources>


    <Grid Margin="28,24,28,26">

        <Grid.RowDefinitions>

            <RowDefinition Height="Auto"/>

            <RowDefinition Height="100"/>

            <RowDefinition Height="150"/>

            <RowDefinition Height="*"/>

        </Grid.RowDefinitions>


        <!-- =====================================================
                              ENCABEZADO
        ====================================================== -->

        <Grid Grid.Row="0"
              Margin="0,0,0,18">

            <Grid.ColumnDefinitions>

                <ColumnDefinition/>

                <ColumnDefinition Width="Auto"/>

            </Grid.ColumnDefinitions>


            <StackPanel>

                <TextBlock
                    Text="FACTURACIÓN"
                    FontSize="29"
                    FontWeight="Bold"
                    Foreground="#172033"/>

                <TextBlock
                    Text="Gestión de cuentas, cobertura de seguros, pagos e historial financiero."
                    FontSize="13"
                    Foreground="#64748B"
                    Margin="0,5,0,0"/>

            </StackPanel>


            <StackPanel
                Grid.Column="1"
                Orientation="Horizontal"
                VerticalAlignment="Center">


                <Button
                    x:Name="btnActualizar"
                    Style="{StaticResource SecondaryButtonStyle}"
                    Width="110"
                    Margin="0,0,8,0"
                    Content="↻ Actualizar"
                    Click="btnActualizar_Click"/>


                <Button
                    x:Name="btnHistorial"
                    Style="{StaticResource PrimaryButtonStyle}"
                    Width="170"
                    Content="Historial de facturas"
                    Click="btnHistorial_Click"/>

            </StackPanel>

        </Grid>


        <!-- =====================================================
                             RESUMEN SUPERIOR
        ====================================================== -->

        <UniformGrid
            Grid.Row="1"
            Columns="4"
            Margin="-5,0,-5,12">


            <!-- FACTURAS HOY -->

            <Border
                Margin="5"
                Background="White"
                BorderBrush="#E2E8F0"
                BorderThickness="1"
                CornerRadius="11"
                Padding="16">

                <StackPanel>

                    <TextBlock
                        Text="Facturas hoy"
                        FontSize="11"
                        Foreground="#64748B"/>

                    <TextBlock
                        x:Name="txtFacturasHoy"
                        Text="0"
                        FontSize="25"
                        FontWeight="Bold"
                        Foreground="#2563EB"
                        Margin="0,5,0,0"/>

                </StackPanel>

            </Border>


            <!-- PENDIENTES -->

            <Border
                Margin="5"
                Background="White"
                BorderBrush="#E2E8F0"
                BorderThickness="1"
                CornerRadius="11"
                Padding="16">

                <StackPanel>

                    <TextBlock
                        Text="Cuentas pendientes"
                        FontSize="11"
                        Foreground="#64748B"/>

                    <TextBlock
                        x:Name="txtPendientes"
                        Text="0"
                        FontSize="25"
                        FontWeight="Bold"
                        Foreground="#EA580C"
                        Margin="0,5,0,0"/>

                </StackPanel>

            </Border>


            <!-- PACIENTE -->

            <Border
                Margin="5"
                Background="White"
                BorderBrush="#E2E8F0"
                BorderThickness="1"
                CornerRadius="11"
                Padding="16">

                <StackPanel>

                    <TextBlock
                        Text="Responsabilidad pacientes"
                        FontSize="11"
                        Foreground="#64748B"/>

                    <TextBlock
                        x:Name="txtMontoPaciente"
                        Text="RD$ 0.00"
                        FontSize="21"
                        FontWeight="Bold"
                        Foreground="#7C3AED"
                        Margin="0,7,0,0"/>

                </StackPanel>

            </Border>


            <!-- ARS -->

            <Border
                Margin="5"
                Background="White"
                BorderBrush="#E2E8F0"
                BorderThickness="1"
                CornerRadius="11"
                Padding="16">

                <StackPanel>

                    <TextBlock
                        Text="Cobertura estimada ARS"
                        FontSize="11"
                        Foreground="#64748B"/>

                    <TextBlock
                        x:Name="txtMontoARS"
                        Text="RD$ 0.00"
                        FontSize="21"
                        FontWeight="Bold"
                        Foreground="#059669"
                        Margin="0,7,0,0"/>

                </StackPanel>

            </Border>

        </UniformGrid>


        <!-- =====================================================
                         ¿QUÉ DESEA FACTURAR?
        ====================================================== -->

        <Grid Grid.Row="2">

            <Grid.RowDefinitions>

                <RowDefinition Height="Auto"/>

                <RowDefinition Height="*"/>

            </Grid.RowDefinitions>


            <TextBlock
                Text="¿Qué desea facturar?"
                FontSize="14"
                FontWeight="SemiBold"
                Foreground="#334155"
                Margin="4,0,0,8"/>


            <UniformGrid
                Grid.Row="1"
                Columns="3"
                Margin="-5,0,-5,12">


                <!-- EMERGENCIA -->

                <Button
                    x:Name="btnEmergencia"
                    Margin="5"
                    Style="{StaticResource TypeButtonStyle}"
                    Click="btnEmergencia_Click">

                    <Grid>

                        <Grid.ColumnDefinitions>

                            <ColumnDefinition Width="55"/>

                            <ColumnDefinition/>

                        </Grid.ColumnDefinitions>


                        <Border
                            Width="46"
                            Height="46"
                            Background="#FEF2F2"
                            CornerRadius="23">

                            <TextBlock
                                Text="🚑"
                                FontSize="24"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>

                        </Border>


                        <StackPanel
                            Grid.Column="1"
                            Margin="12,0,0,0">

                            <TextBlock
                                Text="EMERGENCIA"
                                FontSize="15"
                                FontWeight="Bold"
                                Foreground="#B91C1C"/>

                            <TextBlock
                                Text="Atenciones y consumos realizados durante una emergencia."
                                FontSize="11"
                                Foreground="#64748B"
                                TextWrapping="Wrap"
                                Margin="0,5,0,0"/>

                        </StackPanel>

                    </Grid>

                </Button>


                <!-- INTERNAMIENTO -->

                <Button
                    x:Name="btnInternamiento"
                    Margin="5"
                    Style="{StaticResource TypeButtonStyle}"
                    Click="btnInternamiento_Click">

                    <Grid>

                        <Grid.ColumnDefinitions>

                            <ColumnDefinition Width="55"/>

                            <ColumnDefinition/>

                        </Grid.ColumnDefinitions>


                        <Border
                            Width="46"
                            Height="46"
                            Background="#EFF6FF"
                            CornerRadius="23">

                            <TextBlock
                                Text="🛏"
                                FontSize="23"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>

                        </Border>


                        <StackPanel
                            Grid.Column="1"
                            Margin="12,0,0,0">

                            <TextBlock
                                Text="INTERNAMIENTO"
                                FontSize="15"
                                FontWeight="Bold"
                                Foreground="#1D4ED8"/>

                            <TextBlock
                                Text="Hospitalización, UCI, estancia y consumos del internamiento."
                                FontSize="11"
                                Foreground="#64748B"
                                TextWrapping="Wrap"
                                Margin="0,5,0,0"/>

                        </StackPanel>

                    </Grid>

                </Button>


                <!-- AMBULATORIO -->

                <Button
                    x:Name="btnAmbulatorio"
                    Margin="5"
                    Style="{StaticResource TypeButtonStyle}"
                    Click="btnAmbulatorio_Click">

                    <Grid>

                        <Grid.ColumnDefinitions>

                            <ColumnDefinition Width="55"/>

                            <ColumnDefinition/>

                        </Grid.ColumnDefinitions>


                        <Border
                            Width="46"
                            Height="46"
                            Background="#ECFDF5"
                            CornerRadius="23">

                            <TextBlock
                                Text="⚕"
                                FontSize="25"
                                Foreground="#047857"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>

                        </Border>


                        <StackPanel
                            Grid.Column="1"
                            Margin="12,0,0,0">

                            <TextBlock
                                Text="AMBULATORIO"
                                FontSize="15"
                                FontWeight="Bold"
                                Foreground="#047857"/>

                            <TextBlock
                                Text="Consultas, laboratorio, imágenes y otros servicios externos."
                                FontSize="11"
                                Foreground="#64748B"
                                TextWrapping="Wrap"
                                Margin="0,5,0,0"/>

                        </StackPanel>

                    </Grid>

                </Button>

            </UniformGrid>

        </Grid>


        <!-- =====================================================
                              CONTENIDO
        ====================================================== -->

        <Border
            Grid.Row="3"
            Background="White"
            BorderBrush="#E2E8F0"
            BorderThickness="1"
            CornerRadius="12"
            Padding="18">

            <Grid>


                <!-- =================================================
                                 INICIO
                ================================================== -->

                <StackPanel
                    x:Name="panelInicio"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">

                    <TextBlock
                        Text="$"
                        FontSize="44"
                        FontWeight="Bold"
                        Foreground="#CBD5E1"
                        HorizontalAlignment="Center"/>

                    <TextBlock
                        Text="Seleccione el tipo de facturación"
                        FontSize="18"
                        FontWeight="SemiBold"
                        Foreground="#334155"
                        HorizontalAlignment="Center"
                        Margin="0,10,0,0"/>

                    <TextBlock
                        Text="Emergencia, Internamiento o Ambulatorio"
                        FontSize="12"
                        Foreground="#94A3B8"
                        HorizontalAlignment="Center"
                        Margin="0,5,0,0"/>

                </StackPanel>


                <!-- =================================================
                         LISTA DE EMERGENCIAS
                ================================================== -->

                <Grid
                    x:Name="panelEmergencias"
                    Visibility="Collapsed">

                    <Grid.RowDefinitions>

                        <RowDefinition Height="Auto"/>

                        <RowDefinition Height="Auto"/>

                        <RowDefinition Height="*"/>

                    </Grid.RowDefinitions>


                    <!-- DISTINTIVO -->

                    <Border
                        Grid.Row="0"
                        Background="#FFF1F2"
                        BorderBrush="#FECDD3"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="14"
                        Margin="0,0,0,12">

                        <Grid>

                            <Grid.ColumnDefinitions>

                                <ColumnDefinition/>

                                <ColumnDefinition Width="Auto"/>

                            </Grid.ColumnDefinitions>


                            <StackPanel
                                Orientation="Horizontal">

                                <TextBlock
                                    Text="🚑"
                                    FontSize="23"
                                    Margin="0,0,10,0"/>

                                <StackPanel>

                                    <TextBlock
                                        Text="FACTURANDO: EMERGENCIA"
                                        FontSize="14"
                                        FontWeight="Bold"
                                        Foreground="#B91C1C"/>

                                    <TextBlock
                                        Text="Seleccione una emergencia pendiente para preparar su factura."
                                        FontSize="11"
                                        Foreground="#7F1D1D"
                                        Margin="0,3,0,0"/>

                                </StackPanel>

                            </StackPanel>


                            <TextBlock
                                Grid.Column="1"
                                x:Name="txtCantidadEmergencias"
                                Text="0 pendientes"
                                Foreground="#B91C1C"
                                FontWeight="SemiBold"
                                VerticalAlignment="Center"/>

                        </Grid>

                    </Border>


                    <!-- BUSCADOR -->

                    <TextBox
                        x:Name="txtBuscarEmergencia"
                        Grid.Row="1"
                        Height="38"
                        Width="340"
                        HorizontalAlignment="Left"
                        Padding="12,6"
                        Margin="0,0,0,12"
                        BorderBrush="#CBD5E1"
                        BorderThickness="1"
                        Background="#F8FAFC"
                        VerticalContentAlignment="Center"
                        ToolTip="Buscar código, paciente, documento o seguro"
                        TextChanged="txtBuscarEmergencia_TextChanged"/>


                    <!-- GRID -->

                    <DataGrid
                        x:Name="dgEmergencias"
                        Grid.Row="2"
                        AutoGenerateColumns="False"
                        CanUserAddRows="False"
                        IsReadOnly="True"
                        HeadersVisibility="Column"
                        GridLinesVisibility="Horizontal"
                        BorderBrush="#E2E8F0"
                        BorderThickness="1"
                        MinRowHeight="50"
                        FontSize="11"
                        SelectionMode="Single">

                        <DataGrid.Columns>


                            <DataGridTextColumn
                                Header="Emergencia"
                                Binding="{Binding CodigoOrigen}"
                                Width="100"/>


                            <DataGridTextColumn
                                Header="Paciente"
                                Binding="{Binding NombrePaciente}"
                                Width="*"/>


                            <DataGridTextColumn
                                Header="Fecha"
                                Binding="{Binding FechaMostrar}"
                                Width="145"/>


                            <DataGridTextColumn
                                Header="Seguro"
                                Binding="{Binding Seguro}"
                                Width="135"/>


                            <DataGridTextColumn
                                Header="Items"
                                Binding="{Binding CantidadItems}"
                                Width="55"/>


                            <DataGridTextColumn
                                Header="Sin seguro"
                                Binding="{Binding TotalParticularTexto}"
                                Width="110"/>


                            <DataGridTextColumn
                                Header="ARS"
                                Binding="{Binding TotalSeguroTexto}"
                                Width="105"/>


                            <DataGridTextColumn
                                Header="Paciente"
                                Binding="{Binding TotalPacienteTexto}"
                                Width="105"/>


                            <DataGridTextColumn
                                Header="Estado"
                                Binding="{Binding EstadoCobertura}"
                                Width="130"/>


                            <DataGridTemplateColumn
                                Header="Acción"
                                Width="105">

                                <DataGridTemplateColumn.CellTemplate>

                                    <DataTemplate>

                                        <Button
                                            Style="{StaticResource GridActionButtonStyle}"
                                            Content="Facturar"
                                            Click="btnPrepararEmergencia_Click"/>

                                    </DataTemplate>

                                </DataGridTemplateColumn.CellTemplate>

                            </DataGridTemplateColumn>

                        </DataGrid.Columns>

                    </DataGrid>

                </Grid>

                <!-- =================================================
                             LISTA DE INTERNAMIENTOS
                ================================================== -->

                <Grid
                    x:Name="panelInternamientos"
                    Visibility="Collapsed">

                    <Grid.RowDefinitions>

                        <RowDefinition Height="Auto"/>

                        <RowDefinition Height="Auto"/>

                        <RowDefinition Height="*"/>

                    </Grid.RowDefinitions>


                    <!-- =================================================
                        DISTINTIVO
                    ================================================== -->

                    <Border
                        Grid.Row="0"
                        Background="#EFF6FF"
                        BorderBrush="#BFDBFE"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="14"
                        Margin="0,0,0,12">

                        <Grid>

                            <Grid.ColumnDefinitions>

                                <ColumnDefinition/>

                                <ColumnDefinition Width="Auto"/>

                            </Grid.ColumnDefinitions>


                            <StackPanel
                                 Orientation="Horizontal">

                                <TextBlock
                                    Text="🛏"
                                    FontSize="23"
                                    Margin="0,0,10,0"/>

                                <StackPanel>

                                    <TextBlock
                                        Text="FACTURANDO: INTERNAMIENTO"
                                        FontSize="14"
                                        FontWeight="Bold"
                                        Foreground="#1D4ED8"/>

                                    <TextBlock
                                        Text="Seleccione un internamiento finalizado pendiente de facturar."
                                        FontSize="11"
                                        Foreground="#1E40AF"
                                        Margin="0,3,0,0"/>

                                </StackPanel>

                            </StackPanel>


                            <TextBlock
                                Grid.Column="1"
                                x:Name="txtCantidadInternamientos"
                                Text="0 pendientes"
                                Foreground="#1D4ED8"
                                FontWeight="SemiBold"
                                VerticalAlignment="Center"/>

                        </Grid>

                    </Border>


                    <!-- =================================================
                         BUSCAR
                    ================================================== -->

                    <TextBox
                        x:Name="txtBuscarInternamiento"
                        Grid.Row="1"
                        Height="38"
                        Width="360"
                        HorizontalAlignment="Left"
                        Padding="12,6"
                        Margin="0,0,0,12"
                        BorderBrush="#CBD5E1"
                        BorderThickness="1"
                        Background="#F8FAFC"
                        VerticalContentAlignment="Center"
                        ToolTip="Buscar código, paciente, documento o seguro"
                        TextChanged="txtBuscarInternamiento_TextChanged"/>


                    <!-- =================================================
                         GRID
                     ================================================== -->

                    <DataGrid
                        x:Name="dgInternamientosFacturacion"
                        Grid.Row="2"
                        AutoGenerateColumns="False"
                        CanUserAddRows="False"
                        IsReadOnly="True"
                        HeadersVisibility="Column"
                        GridLinesVisibility="Horizontal"
                        BorderBrush="#E2E8F0"
                        BorderThickness="1"
                        MinRowHeight="50"
                        FontSize="11"
                        SelectionMode="Single">

                        <DataGrid.Columns>


                            <DataGridTextColumn
                                    Header="Internamiento"
                                    Binding="{Binding CodigoOrigen}"
                                    Width="110"/>


                            <DataGridTextColumn
                                    Header="Paciente"
                                    Binding="{Binding NombrePaciente}"
                                    Width="*"/>


                            <DataGridTextColumn
                                    Header="Ingreso"
                                    Binding="{Binding FechaMostrar}"
                                    Width="145"/>


                            <DataGridTextColumn
                                    Header="Seguro"
                                    Binding="{Binding Seguro}"
                                    Width="135"/>


                            <DataGridTextColumn
                                    Header="Cargos"
                                    Binding="{Binding CantidadItems}"
                                    Width="65"/>


                            <DataGridTextColumn
                                    Header="Sin seguro"
                                    Binding="{Binding TotalParticularTexto}"
                                    Width="110"/>


                            <DataGridTextColumn
                                    Header="ARS"
                                    Binding="{Binding TotalSeguroTexto}"
                                    Width="105"/>


                            <DataGridTextColumn
                                    Header="Paciente"
                                    Binding="{Binding TotalPacienteTexto}"
                                    Width="105"/>


                            <DataGridTextColumn
                                    Header="Estado"
                                    Binding="{Binding EstadoCobertura}"
                                    Width="135"/>


                            <DataGridTemplateColumn
                                            Header="Acción"
                                            Width="105">

                                <DataGridTemplateColumn.CellTemplate>

                                    <DataTemplate>

                                        <Button
                                            Style="{StaticResource GridActionButtonStyle}"
                                            Content="Facturar"
                                            Click="btnPrepararInternamiento_Click"/>    

                                    </DataTemplate>

                                </DataGridTemplateColumn.CellTemplate>

                            </DataGridTemplateColumn>

                        </DataGrid.Columns>

                    </DataGrid>

                </Grid>



                <!-- =================================================
                         PREPARAR FACTURA EMERGENCIA
                ================================================== -->

                <Grid
                    x:Name="panelDetalle"
                    Visibility="Collapsed">

                    <Grid.RowDefinitions>

                        <RowDefinition Height="Auto"/>

                        <RowDefinition Height="Auto"/>

                        <RowDefinition Height="*"/>

                        <RowDefinition Height="Auto"/>

                    </Grid.RowDefinitions>


                    <!-- =================================================
                     BANNER DEL ORIGEN
================================================== -->

                    <Border
    x:Name="bannerDetalle"
    Grid.Row="0"
    Background="#FFF1F2"
    BorderBrush="#FECDD3"
    BorderThickness="1"
    CornerRadius="8"
    Padding="14"
    Margin="0,0,0,12">

                        <Grid>

                            <Grid.ColumnDefinitions>

                                <ColumnDefinition/>

                                <ColumnDefinition Width="Auto"/>

                            </Grid.ColumnDefinitions>


                            <StackPanel
                                  Orientation="Horizontal">

                                <TextBlock
                                    x:Name="txtIconoDetalle"
                                    Text="🚑"
                                    FontSize="25"
                                    Margin="0,0,10,0"/>

                                <StackPanel>

                                    <TextBlock
                                        x:Name="txtTipoDetalle"
                                        Text="FACTURANDO: EMERGENCIA"
                                        FontSize="14"
                                        FontWeight="Bold"
                                        Foreground="#B91C1C"/>

                                    <TextBlock
                                        x:Name="txtOrigenDetalle"
                                        Text="EM000000"
                                        FontSize="12"
                                        FontWeight="SemiBold"
                                        Foreground="#7F1D1D"
                                        Margin="0,3,0,0"/>

                                </StackPanel>

                            </StackPanel>


                            <Button
                                Grid.Column="1"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Content="← Volver"
                                Click="btnVolverDetalle_Click"/>

                        </Grid>

                    </Border>


                    <!-- PACIENTE -->

                    <Grid
                        Grid.Row="1"
                        Margin="0,0,0,12">

                        <Grid.ColumnDefinitions>

                            <ColumnDefinition Width="2*"/>

                            <ColumnDefinition/>

                            <ColumnDefinition/>

                            <ColumnDefinition/>

                        </Grid.ColumnDefinitions>


                        <StackPanel>

                            <TextBlock
                                Text="Paciente"
                                FontSize="10"
                                Foreground="#64748B"/>

                            <TextBlock
                                x:Name="txtPacienteDetalle"
                                FontWeight="SemiBold"
                                Foreground="#172033"
                                Margin="0,3,0,0"/>

                        </StackPanel>


                        <StackPanel
                            Grid.Column="1">

                            <TextBlock
                                Text="Documento"
                                FontSize="10"
                                Foreground="#64748B"/>

                            <TextBlock
                                x:Name="txtDocumentoDetalle"
                                FontWeight="SemiBold"
                                Foreground="#172033"
                                Margin="0,3,0,0"/>

                        </StackPanel>


                        <StackPanel
                            Grid.Column="2">

                            <TextBlock
                                Text="Seguro"
                                FontSize="10"
                                Foreground="#64748B"/>

                            <TextBlock
                                x:Name="txtSeguroDetalle"
                                FontWeight="SemiBold"
                                Foreground="#172033"
                                Margin="0,3,0,0"/>

                        </StackPanel>


                        <StackPanel
                            Grid.Column="3">

                            <TextBlock
                                Text="Plan"
                                FontSize="10"
                                Foreground="#64748B"/>

                            <TextBlock
                                x:Name="txtPlanDetalle"
                                FontWeight="SemiBold"
                                Foreground="#172033"
                                Margin="0,3,0,0"/>

                        </StackPanel>

                    </Grid>


                    <!-- ITEMS -->

                    <DataGrid
                        x:Name="dgDetalle"
                        Grid.Row="2"
                        AutoGenerateColumns="False"
                        CanUserAddRows="False"
                        IsReadOnly="True"
                        HeadersVisibility="Column"
                        GridLinesVisibility="Horizontal"
                        BorderBrush="#E2E8F0"
                        BorderThickness="1"
                        MinRowHeight="44"
                        FontSize="10.5">

                        <DataGrid.Columns>

                            <DataGridTextColumn
                                Header="Tipo"
                                Binding="{Binding TipoItem}"
                                Width="105"/>

                            <DataGridTextColumn
                                Header="Servicio"
                                Binding="{Binding Descripcion}"
                                Width="*"/>

                            <DataGridTextColumn
                                Header="Cant."
                                Binding="{Binding Cantidad}"
                                Width="55"/>

                            <DataGridTextColumn
                                Header="Sin seguro"
                                Binding="{Binding TotalParticularTexto}"
                                Width="105"/>

                            <DataGridTextColumn
                                Header="Tarifa plan"
                                Binding="{Binding TotalTarifaTexto}"
                                Width="105"/>

                            <DataGridTextColumn
                                Header="Cobertura"
                                Binding="{Binding CoberturaTexto}"
                                Width="75"/>

                            <DataGridTextColumn
                                Header="ARS paga"
                                Binding="{Binding MontoSeguroTexto}"
                                Width="100"/>

                            <DataGridTextColumn
                                Header="Paciente"
                                Binding="{Binding MontoPacienteTexto}"
                                Width="100"/>

                            <DataGridTextColumn
                                Header="Estado"
                                Binding="{Binding EstadoCobertura}"
                                Width="135"/>

                        </DataGrid.Columns>

                    </DataGrid>


                    <!-- RESUMEN -->

                    <Grid
                        Grid.Row="3"
                        Margin="0,14,0,0">

                        <Grid.ColumnDefinitions>

                            <ColumnDefinition/>

                            <ColumnDefinition Width="390"/>

                        </Grid.ColumnDefinitions>


                        <!-- AUTORIZACIÓN -->

                        <StackPanel
                            x:Name="panelAutorizacion"
                            Visibility="Collapsed"
                            VerticalAlignment="Bottom"
                            Margin="0,0,30,0">

                            <TextBlock
                                Text="Autorización del seguro"
                                FontSize="11"
                                FontWeight="SemiBold"
                                Foreground="#B45309"/>

                            <TextBlock
                                Text="Uno o más servicios requieren autorización."
                                FontSize="10"
                                Foreground="#92400E"
                                Margin="0,3,0,6"/>

                            <TextBox
                                x:Name="txtAutorizacion"
                                Width="300"
                                Height="36"
                                HorizontalAlignment="Left"
                                Padding="10,5"
                                BorderBrush="#F59E0B"
                                BorderThickness="1"/>

                        </StackPanel>


                        <!-- TOTALES -->

                        <Border
                            Grid.Column="1"
                            Background="#F8FAFC"
                            BorderBrush="#E2E8F0"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="14">

                            <StackPanel>

                                <Grid Margin="0,2">

                                    <TextBlock
                                        Text="Precio total sin seguro"
                                        Foreground="#64748B"/>

                                    <TextBlock
                                        x:Name="txtTotalParticularDetalle"
                                        HorizontalAlignment="Right"
                                        FontWeight="SemiBold"/>

                                </Grid>


                                <Grid Margin="0,4">

                                    <TextBlock
                                        Text="Tarifa aplicada"
                                        Foreground="#64748B"/>

                                    <TextBlock
                                        x:Name="txtTotalTarifaDetalle"
                                        HorizontalAlignment="Right"
                                        FontWeight="SemiBold"/>

                                </Grid>


                                <Separator Margin="0,7"/>


                                <Grid Margin="0,3">

                                    <TextBlock
                                        Text="Cobertura ARS"
                                        Foreground="#059669"
                                        FontWeight="SemiBold"/>

                                    <TextBlock
                                        x:Name="txtTotalARSDetalle"
                                        HorizontalAlignment="Right"
                                        Foreground="#059669"
                                        FontWeight="Bold"/>

                                </Grid>


                                <Grid Margin="0,3">

                                    <TextBlock
                                        Text="PACIENTE PAGA"
                                        Foreground="#7C3AED"
                                        FontWeight="Bold"/>

                                    <TextBlock
                                        x:Name="txtTotalPacienteDetalle"
                                        HorizontalAlignment="Right"
                                        Foreground="#7C3AED"
                                        FontSize="16"
                                        FontWeight="Bold"/>

                                </Grid>


                                <Button
                                    x:Name="btnGenerarFactura"
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    Height="40"
                                    Margin="0,12,0,0"
                                    Content="GENERAR FACTURA"
                                    Click="btnGenerarFactura_Click"/>

                            </StackPanel>

                        </Border>

                    </Grid>

                </Grid>


                <!-- =================================================
                                     HISTORIAL
                ================================================== -->

                <Grid
                    x:Name="panelHistorial"
                    Visibility="Collapsed">

                    <Grid.RowDefinitions>

                        <RowDefinition Height="Auto"/>

                        <RowDefinition Height="Auto"/>

                        <RowDefinition Height="*"/>

                    </Grid.RowDefinitions>


                    <Grid Grid.Row="0"
                          Margin="0,0,0,12">

                        <Grid.ColumnDefinitions>

                            <ColumnDefinition/>

                            <ColumnDefinition Width="Auto"/>

                        </Grid.ColumnDefinitions>


                        <StackPanel>

                            <TextBlock
                                Text="HISTORIAL DE FACTURAS"
                                FontSize="16"
                                FontWeight="Bold"
                                Foreground="#172033"/>

                            <TextBlock
                                Text="Consulte las facturas generadas durante las visitas de los pacientes."
                                FontSize="11"
                                Foreground="#64748B"
                                Margin="0,4,0,0"/>

                        </StackPanel>


                        <Button
                            Grid.Column="1"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Content="← Volver"
                            Click="btnVolverInicio_Click"/>

                    </Grid>


                    <TextBox
                        x:Name="txtBuscarFactura"
                        Grid.Row="1"
                        Width="360"
                        Height="38"
                        HorizontalAlignment="Left"
                        Padding="12,6"
                        Margin="0,0,0,12"
                        Background="#F8FAFC"
                        BorderBrush="#CBD5E1"
                        ToolTip="Buscar factura, paciente, origen o seguro"
                        TextChanged="txtBuscarFactura_TextChanged"/>


                    <DataGrid
                        x:Name="dgHistorial"
                        Grid.Row="2"
                        AutoGenerateColumns="False"
                        CanUserAddRows="False"
                        IsReadOnly="True"
                        HeadersVisibility="Column"
                        GridLinesVisibility="Horizontal"
                        BorderBrush="#E2E8F0"
                        BorderThickness="1"
                        MinRowHeight="48"
                        FontSize="11">

                        <DataGrid.Columns>

                            <DataGridTextColumn
                                Header="Factura"
                                Binding="{Binding CodigoFactura}"
                                Width="105"/>

                            <DataGridTextColumn
                                Header="Fecha"
                                Binding="{Binding FechaMostrar}"
                                Width="145"/>

                            <DataGridTextColumn
                                Header="Paciente"
                                Binding="{Binding NombrePaciente}"
                                Width="*"/>

                            <DataGridTextColumn
                                Header="Tipo"
                                Binding="{Binding TipoFactura}"
                                Width="110"/>

                            <DataGridTextColumn
                                Header="Origen"
                                Binding="{Binding CodigoOrigen}"
                                Width="100"/>

                            <DataGridTextColumn
                                Header="Seguro"
                                Binding="{Binding Seguro}"
                                Width="125"/>

                            <DataGridTextColumn
                                Header="Total"
                                Binding="{Binding TotalTexto}"
                                Width="105"/>

                            <DataGridTextColumn
                                Header="ARS"
                                Binding="{Binding SeguroPagaTexto}"
                                Width="100"/>

                            <DataGridTextColumn
                                Header="Paciente"
                                Binding="{Binding PacientePagaTexto}"
                                Width="100"/>

                            <DataGridTextColumn
                                Header="Estado"
                                Binding="{Binding Estado}"
                                Width="105"/>

                        </DataGrid.Columns>

                    </DataGrid>

                </Grid>


                <!-- =================================================
                                MÓDULOS SIGUIENTES
                ================================================== -->

                <StackPanel
                    x:Name="panelPendienteIntegracion"
                    Visibility="Collapsed"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">

                    <TextBlock
                        x:Name="txtIconoPendiente"
                        Text="🛏"
                        FontSize="42"
                        HorizontalAlignment="Center"/>

                    <TextBlock
                        x:Name="txtTituloPendiente"
                        Text="Facturación de Internamiento"
                        FontSize="18"
                        FontWeight="Bold"
                        Foreground="#334155"
                        HorizontalAlignment="Center"
                        Margin="0,8,0,0"/>

                    <TextBlock
                        x:Name="txtDescripcionPendiente"
                        Text="La interfaz está preparada. Conectaremos los cargos en la siguiente etapa."
                        FontSize="11"
                        Foreground="#64748B"
                        HorizontalAlignment="Center"
                        Margin="0,5,0,0"/>

                </StackPanel>

            </Grid>

        </Border>

    </Grid>

</Page>