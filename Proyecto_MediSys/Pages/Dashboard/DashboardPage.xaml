<Page x:Class="Proyecto_MediSys.Pages.Dashboard.DashboardPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      mc:Ignorable="d"
      Background="#F5F7FA">

    <Grid>

        <StackPanel>

            <TextBlock Text="Bienvenido a MediSys"
                       FontSize="30"
                       FontWeight="Bold"
                       Foreground="#1E293B"
                       Margin="0,0,0,5"/>

            <TextBlock Text="Panel de administración clínica"
                       FontSize="16"
                       Foreground="Gray"
                       Margin="0,0,0,30"/>

            <!-- TARJETAS -->

            <WrapPanel>

                <!-- PACIENTES -->

                <Border Width="250"
                        Height="140"
                        Background="White"
                        CornerRadius="12"
                        Margin="10">

                    <StackPanel VerticalAlignment="Center">

                        <TextBlock Text="👤 Pacientes"
                                   FontSize="20"
                                   FontWeight="Bold"
                                   HorizontalAlignment="Center"
                                   Margin="0,20,0,10"/>

                        <TextBlock Text="120"
                                   FontSize="40"
                                   FontWeight="Bold"
                                   HorizontalAlignment="Center"/>

                    </StackPanel>

                </Border>

                <!-- MÉDICOS -->

                <Border Width="250"
                        Height="140"
                        Background="White"
                        CornerRadius="12"
                        Margin="10">

                    <StackPanel VerticalAlignment="Center">

                        <TextBlock Text="👨‍⚕️ Médicos"
                                   FontSize="20"
                                   FontWeight="Bold"
                                   HorizontalAlignment="Center"
                                   Margin="0,20,0,10"/>

                        <TextBlock Text="15"
                                   FontSize="40"
                                   FontWeight="Bold"
                                   HorizontalAlignment="Center"/>

                    </StackPanel>

                </Border>

                <!-- CITAS -->

                <Border Width="250"
                        Height="140"
                        Background="White"
                        CornerRadius="12"
                        Margin="10">

                    <StackPanel VerticalAlignment="Center">

                        <TextBlock Text="📅 Citas Hoy"
                                   FontSize="20"
                                   FontWeight="Bold"
                                   HorizontalAlignment="Center"
                                   Margin="0,20,0,10"/>

                        <TextBlock Text="34"
                                   FontSize="40"
                                   FontWeight="Bold"
                                   HorizontalAlignment="Center"/>

                    </StackPanel>

                </Border>

                <!-- INGRESOS -->

                <Border Width="250"
                        Height="140"
                        Background="White"
                        CornerRadius="12"
                        Margin="10">

                    <StackPanel VerticalAlignment="Center">

                        <TextBlock Text="💰 Ingresos"
                                   FontSize="20"
                                   FontWeight="Bold"
                                   HorizontalAlignment="Center"
                                   Margin="0,20,0,10"/>

                        <TextBlock Text="$12,500"
                                   FontSize="30"
                                   FontWeight="Bold"
                                   HorizontalAlignment="Center"/>

                    </StackPanel>

                </Border>

            </WrapPanel>

            <!-- ACTIVIDAD -->

            <Border Background="White"
                    CornerRadius="12"
                    Margin="10,30,10,0"
                    Padding="20">

                <StackPanel>

                    <TextBlock Text="Actividad Reciente"
                               FontSize="22"
                               FontWeight="Bold"
                               Margin="0,0,0,20"/>

                    <TextBlock Text="• Paciente Juan Pérez registrado."
                               Margin="0,5"/>

                    <TextBlock Text="• Nueva cita programada para hoy."
                               Margin="0,5"/>

                    <TextBlock Text="• Historial médico actualizado."
                               Margin="0,5"/>

                    <TextBlock Text="• Factura generada correctamente."
                               Margin="0,5"/>

                </StackPanel>

            </Border>

        </StackPanel>

    </Grid>

</Page>