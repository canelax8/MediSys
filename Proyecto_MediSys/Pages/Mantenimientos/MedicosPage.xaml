<Page x:Class="Proyecto_MediSys.Pages.Mantenimientos.MedicosPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="#F4F6F8">


    <Page.Resources>


        <Style x:Key="ActionButtonStyle"
               TargetType="Button">

            <Setter Property="Height"
                    Value="32"/>

            <Setter Property="Margin"
                    Value="3,0"/>

            <Setter Property="Padding"
                    Value="10,0"/>

            <Setter Property="Background"
                    Value="White"/>

            <Setter Property="Foreground"
                    Value="#334155"/>

            <Setter Property="BorderBrush"
                    Value="#CBD5E1"/>

            <Setter Property="BorderThickness"
                    Value="1"/>

            <Setter Property="FontSize"
                    Value="11"/>

            <Setter Property="FontWeight"
                    Value="SemiBold"/>

            <Setter Property="Cursor"
                    Value="Hand"/>

        </Style>

    </Page.Resources>


    <Grid Margin="28">

        <Grid.RowDefinitions>

            <RowDefinition Height="Auto"/>

            <RowDefinition Height="110"/>

            <RowDefinition Height="Auto"/>

            <RowDefinition Height="*"/>

        </Grid.RowDefinitions>


        <!-- =====================================================
                            ENCABEZADO
        ====================================================== -->

        <Grid Grid.Row="0"
              Margin="0,0,0,22">

            <StackPanel>

                <TextBlock
                    Text="Gestión de Médicos"
                    FontSize="28"
                    FontWeight="Bold"
                    Foreground="#172033"/>

                <TextBlock
                    Text="Administración del personal médico y sus especialidades"
                    Margin="0,5,0,0"
                    FontSize="14"
                    Foreground="#64748B"/>

            </StackPanel>

        </Grid>


        <!-- =====================================================
                            TARJETAS
        ====================================================== -->

        <Grid Grid.Row="1">

            <Grid.ColumnDefinitions>

                <ColumnDefinition/>

                <ColumnDefinition/>

                <ColumnDefinition/>

                <ColumnDefinition Width="2*"/>

            </Grid.ColumnDefinitions>


            <!-- TOTAL -->

            <Border Grid.Column="0"
                    Height="88"
                    Margin="0,0,12,0"
                    Background="White"
                    BorderBrush="#E2E8F0"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="16">

                <StackPanel>

                    <TextBlock
                        Text="Total médicos"
                        FontSize="12"
                        Foreground="#64748B"/>

                    <TextBlock
                        x:Name="txtTotalMedicos"
                        Text="0"
                        Margin="0,7,0,0"
                        FontSize="27"
                        FontWeight="Bold"
                        Foreground="#2563EB"/>

                </StackPanel>

            </Border>


            <!-- ACTIVOS -->

            <Border Grid.Column="1"
                    Height="88"
                    Margin="0,0,12,0"
                    Background="White"
                    BorderBrush="#E2E8F0"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="16">

                <StackPanel>

                    <TextBlock
                        Text="Médicos activos"
                        FontSize="12"
                        Foreground="#64748B"/>

                    <TextBlock
                        x:Name="txtActivos"
                        Text="0"
                        Margin="0,7,0,0"
                        FontSize="27"
                        FontWeight="Bold"
                        Foreground="#16A34A"/>

                </StackPanel>

            </Border>


            <!-- INACTIVOS -->

            <Border Grid.Column="2"
                    Height="88"
                    Margin="0,0,12,0"
                    Background="White"
                    BorderBrush="#E2E8F0"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="16">

                <StackPanel>

                    <TextBlock
                        Text="Inactivos"
                        FontSize="12"
                        Foreground="#64748B"/>

                    <TextBlock
                        x:Name="txtInactivos"
                        Text="0"
                        Margin="0,7,0,0"
                        FontSize="27"
                        FontWeight="Bold"
                        Foreground="#DC2626"/>

                </StackPanel>

            </Border>

        </Grid>


        <!-- =====================================================
                            BUSCADOR
        ====================================================== -->

        <Border Grid.Row="2"
                Background="White"
                BorderBrush="#E2E8F0"
                BorderThickness="1"
                CornerRadius="10"
                Padding="14"
                Margin="0,0,0,18">

            <Grid>

                <Grid.ColumnDefinitions>

                    <ColumnDefinition Width="2*"/>

                    <ColumnDefinition Width="230"/>

                    <ColumnDefinition Width="20"/>

                    <ColumnDefinition Width="180"/>

                </Grid.ColumnDefinitions>


                <!-- BUSCAR -->

                <Border Grid.Column="0"
                        Height="42"
                        Background="#F8FAFC"
                        BorderBrush="#CBD5E1"
                        BorderThickness="1"
                        CornerRadius="7">

                    <DockPanel>

                        <TextBlock
                            Text="⌕"
                            Width="40"
                            FontSize="20"
                            Foreground="#64748B"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"/>


                        <TextBox
                            x:Name="txtBuscar"
                            BorderThickness="0"
                            Background="Transparent"
                            Padding="5,0"
                            FontSize="13"
                            VerticalContentAlignment="Center"
                            TextChanged="txtBuscar_TextChanged"/>

                    </DockPanel>

                </Border>


                <!-- ESPECIALIDAD -->

                <ComboBox
                    x:Name="cmbEspecialidad"
                    Grid.Column="1"
                    Margin="12,0,0,0"
                    Height="42"
                    Padding="8,3"
                    Background="White"
                    BorderBrush="#CBD5E1"
                    SelectionChanged="cmbEspecialidad_SelectionChanged"/>


                <!-- NUEVO -->

                <Button
                    x:Name="btnNuevoMedico"
                    Grid.Column="3"
                    Height="42"
                    Content="+ Nuevo médico"
                    Background="#2563EB"
                    Foreground="White"
                    BorderThickness="0"
                    FontWeight="SemiBold"
                    Cursor="Hand"
                    Click="btnNuevoMedico_Click"/>

            </Grid>

        </Border>


        <!-- =====================================================
                            TABLA
        ====================================================== -->

        <Border Grid.Row="3"
                Background="White"
                BorderBrush="#E2E8F0"
                BorderThickness="1"
                CornerRadius="10"
                Padding="1">

            <DataGrid
                x:Name="dgMedicos"

                AutoGenerateColumns="False"
                CanUserAddRows="False"
                IsReadOnly="True"

                HeadersVisibility="Column"

                GridLinesVisibility="Horizontal"

                HorizontalGridLinesBrush="#E2E8F0"
                VerticalGridLinesBrush="Transparent"

                Background="White"
                BorderThickness="0"

                MinRowHeight="54"
                ColumnHeaderHeight="44"

                AlternatingRowBackground="#F8FAFC"

                SelectionMode="Single"
                SelectionUnit="FullRow">


                <DataGrid.ColumnHeaderStyle>

                    <Style TargetType="DataGridColumnHeader">

                        <Setter Property="Background"
                                Value="#F8FAFC"/>

                        <Setter Property="Foreground"
                                Value="#475569"/>

                        <Setter Property="FontWeight"
                                Value="SemiBold"/>

                        <Setter Property="FontSize"
                                Value="12"/>

                        <Setter Property="Padding"
                                Value="10,0"/>

                        <Setter Property="VerticalContentAlignment"
                                Value="Center"/>

                    </Style>

                </DataGrid.ColumnHeaderStyle>


                <DataGrid.CellStyle>

                    <Style TargetType="DataGridCell">

                        <Setter Property="BorderThickness"
                                Value="0"/>

                        <Setter Property="Padding"
                                Value="10,0"/>

                        <Setter Property="VerticalContentAlignment"
                                Value="Center"/>

                        <Setter Property="Foreground"
                                Value="#334155"/>

                        <Setter Property="FontSize"
                                Value="12"/>

                    </Style>

                </DataGrid.CellStyle>


                <DataGrid.Columns>


                    <DataGridTextColumn
                        Header="Código"
                        Binding="{Binding CodigoMedico}"
                        Width="105"/>


                    <DataGridTextColumn
                        Header="Médico"
                        Binding="{Binding NombreCompleto}"
                        Width="1.4*"/>


                    <DataGridTextColumn
                        Header="Cédula"
                        Binding="{Binding Cedula}"
                        Width="125"/>


                    <DataGridTextColumn
                        Header="Exequátur"
                        Binding="{Binding Exequatur}"
                        Width="115"/>


                    <DataGridTextColumn
                        Header="Especialidad"
                        Binding="{Binding NombreEspecialidad}"
                        Width="1.2*"/>


                    <DataGridTextColumn
                        Header="Teléfono"
                        Binding="{Binding Telefono}"
                        Width="120"/>


                    <!-- ESTADO -->

                    <DataGridTemplateColumn
                        Header="Estado"
                        Width="100">

                        <DataGridTemplateColumn.CellTemplate>

                            <DataTemplate>

                                <Border
                                    x:Name="EstadoBorder"
                                    HorizontalAlignment="Left"
                                    Padding="10,4"
                                    CornerRadius="10"
                                    Background="#FEE2E2">

                                    <TextBlock
                                        x:Name="EstadoTexto"
                                        Text="{Binding Estado}"
                                        FontSize="11"
                                        FontWeight="SemiBold"
                                        Foreground="#B91C1C"/>

                                </Border>


                                <DataTemplate.Triggers>

                                    <DataTrigger
                                        Binding="{Binding Activo}"
                                        Value="True">

                                        <Setter
                                            TargetName="EstadoBorder"
                                            Property="Background"
                                            Value="#DCFCE7"/>

                                        <Setter
                                            TargetName="EstadoTexto"
                                            Property="Foreground"
                                            Value="#15803D"/>

                                    </DataTrigger>

                                </DataTemplate.Triggers>

                            </DataTemplate>

                        </DataGridTemplateColumn.CellTemplate>

                    </DataGridTemplateColumn>


                    <!-- ==========================================
                                ACCIONES
                    =========================================== -->

                    <DataGridTemplateColumn
                        Header="Acciones"
                        Width="270">

                        <DataGridTemplateColumn.CellTemplate>

                            <DataTemplate>

                                <StackPanel
                                    Orientation="Horizontal"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center">


                                    <Button
                                        Width="62"
                                        Style="{StaticResource ActionButtonStyle}"
                                        Content="Ver"
                                        Foreground="#2563EB"
                                        Click="btnVer_Click"/>


                                    <Button
                                        Width="68"
                                        Style="{StaticResource ActionButtonStyle}"
                                        Content="Editar"
                                        Foreground="#2457A6"
                                        Click="btnEditar_Click"/>


                                    <Button
                                        Width="95"
                                        Content="{Binding AccionEstado}"
                                        Click="btnCambiarEstado_Click">

                                        <Button.Style>

                                            <Style
                                                TargetType="Button"
                                                BasedOn="{StaticResource ActionButtonStyle}">

                                                <Setter
                                                    Property="Foreground"
                                                    Value="#16A34A"/>

                                                <Setter
                                                    Property="BorderBrush"
                                                    Value="#BBF7D0"/>

                                                <Setter
                                                    Property="Background"
                                                    Value="#F0FDF4"/>


                                                <Style.Triggers>

                                                    <DataTrigger
                                                        Binding="{Binding Activo}"
                                                        Value="True">

                                                        <Setter
                                                            Property="Foreground"
                                                            Value="#B91C1C"/>

                                                        <Setter
                                                            Property="BorderBrush"
                                                            Value="#FECACA"/>

                                                        <Setter
                                                            Property="Background"
                                                            Value="#FEF2F2"/>

                                                    </DataTrigger>

                                                </Style.Triggers>

                                            </Style>

                                        </Button.Style>

                                    </Button>

                                </StackPanel>

                            </DataTemplate>

                        </DataGridTemplateColumn.CellTemplate>

                    </DataGridTemplateColumn>

                </DataGrid.Columns>

            </DataGrid>

        </Border>

    </Grid>

</Page>