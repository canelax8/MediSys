<Page x:Class="Proyecto_MediSys.Pages.Mantenimientos.PacientesPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="#F4F6F9">

    <Grid Margin="25">

        <!-- FILAS -->

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="110"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ========================================= -->
        <!-- TITULO -->
        <!-- ========================================= -->

        <StackPanel Grid.Row="0">

            <TextBlock Text="Gestión de Pacientes"
                       FontSize="30"
                       FontWeight="Bold"
                       Foreground="#1E293B"/>

            <TextBlock Text="Administración de pacientes registrados"
                       FontSize="15"
                       Foreground="Gray"
                       Margin="0,5,0,25"/>

        </StackPanel>

        <!-- ========================================= -->
        <!-- TARJETA -->
        <!-- ========================================= -->

        <Border Grid.Row="1"
                Width="230"
                Height="85"
                HorizontalAlignment="Left"
                CornerRadius="12"
                Background="White"
                BorderBrush="#E5E7EB"
                BorderThickness="1"
                Padding="15">

            <StackPanel>

                <TextBlock Text="👥 Total Pacientes"
                           FontSize="14"
                           Foreground="Gray"/>

                <TextBlock x:Name="txtTotalPacientes"
                           Text="0"
                           FontSize="30"
                           FontWeight="Bold"
                           Foreground="#2563EB"/>

            </StackPanel>

        </Border>

        <!-- ========================================= -->
        <!-- BUSCADOR -->
        <!-- ========================================= -->

        <Grid Grid.Row="2"
              Margin="0,15,0,20">

            <Grid.ColumnDefinitions>

                <ColumnDefinition Width="300"/>

                <ColumnDefinition Width="*"/>

                <ColumnDefinition Width="180"/>

            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Height="42"
                    CornerRadius="8"
                    Background="White"
                    BorderBrush="#D1D5DB"
                    BorderThickness="1">

                <DockPanel>

                    <TextBlock Text="🔍"
                               FontSize="18"
                               Margin="12,0"
                               VerticalAlignment="Center"/>

                    <TextBox x:Name="txtBuscar"
                             BorderThickness="0"
                             Background="Transparent"
                             FontSize="15"
                             VerticalContentAlignment="Center"
                             TextChanged="txtBuscar_TextChanged"/>

                </DockPanel>

            </Border>

            <!-- BOTON NUEVO -->

            <Button
    x:Name="btnNuevoPaciente"
    Grid.Column="2"
    Height="44"
    Cursor="Hand"
    FontSize="15"
    FontWeight="SemiBold"
    Foreground="White"
    Content="+ Nuevo Paciente"
    Click="btnNuevoPaciente_Click">

                <Button.Style>

                    <Style TargetType="Button">

                        <Setter Property="Background"
                    Value="#2563EB"/>

                        <Setter Property="BorderBrush"
                    Value="#2563EB"/>

                        <Setter Property="BorderThickness"
                    Value="0"/>

                        <Setter Property="Padding"
                    Value="15,5"/>

                        <Style.Triggers>

                            <Trigger Property="IsMouseOver"
                         Value="True">

                                <Setter Property="Background"
                            Value="#1D4ED8"/>

                            </Trigger>

                        </Style.Triggers>

                    </Style>

                </Button.Style>

            </Button>

        </Grid>

        <!-- ========================================= -->
        <!-- TABLA -->
        <!-- ========================================= -->

        <Border Grid.Row="3"
                Background="White"
                CornerRadius="12"
                Padding="10">

            <DataGrid x:Name="dgPacientes"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      IsReadOnly="True"
                      HeadersVisibility="Column"
                      GridLinesVisibility="Horizontal"
                      RowHeight="55"
                      FontSize="14"
                      BorderThickness="0"
                      Background="White"
                      AlternatingRowBackground="#F8FAFC"
                      HorizontalGridLinesBrush="#E5E7EB"
                      VerticalGridLinesBrush="#E5E7EB"
                      SelectionMode="Single"
                      SelectionUnit="FullRow">

                <DataGrid.Columns>

                    <!-- FOTO -->

                    <DataGridTemplateColumn Header="Foto"
                            Width="75">

                        <DataGridTemplateColumn.CellTemplate>

                            <DataTemplate>

                                <Border Width="40"
                        Height="40"
                        CornerRadius="20"
                        Background="#EEF2FF"
                        BorderBrush="#4F46E5"
                        BorderThickness="1"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">

                                    <TextBlock Text="👤"
                               FontSize="18"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>

                                </Border>

                            </DataTemplate>

                        </DataGridTemplateColumn.CellTemplate>

                    </DataGridTemplateColumn>

                    <!-- CODIGO -->

                    <DataGridTextColumn Header="Código"
                        Binding="{Binding IdPaciente}"
                        Width="90"/>

                    <!-- PACIENTE -->

                    <DataGridTextColumn Header="Paciente"
                        Binding="{Binding NombreCompleto}"
                        Width="220"/>

                    <!-- DOCUMENTO -->

                    <DataGridTextColumn Header="Documento"
                        Binding="{Binding NumeroDocumento}"
                        Width="170"/>

                    <!-- TIPO -->

                    <DataGridTextColumn Header="Tipo"
                        Binding="{Binding TipoPaciente}"
                        Width="120"/>

                    <!-- TELEFONO -->

                    <DataGridTextColumn Header="Teléfono"
                        Binding="{Binding Telefono}"
                        Width="120"/>

                    <!-- SEGURO -->

                    <DataGridTextColumn Header="Seguro"
                        Binding="{Binding SeguroMedico}"
                        Width="150"/>

                    <!-- FECHA -->

                    <DataGridTextColumn Header="Fecha"
                        Binding="{Binding FechaRegistroTexto}"
                        Width="110"/>

                    <!-- HORA -->

                    <DataGridTextColumn Header="Hora"
                        Binding="{Binding HoraRegistroTexto}"
                        Width="90"/>

                    <!-- ESTADO -->

                    <DataGridTextColumn Header="Estado"
                        Binding="{Binding EstadoTexto}"
                        Width="90"/>

                    <!-- ACCIONES -->

                    <DataGridTemplateColumn Header="Acciones"
                            Width="170">

                        <DataGridTemplateColumn.CellTemplate>

                            <DataTemplate>

                                <StackPanel Orientation="Horizontal"
                                            HorizontalAlignment="Center">

                                    <!-- VER -->

                                    <Button
                                            Content="👁"
                                            Width="34"
                                            Height="34"
                                            Margin="2"
                                            Cursor="Hand"
                                            Background="#059669"
                                            Foreground="White"
                                            BorderBrush="#059669"
                                            Click="btnVer_Click"
                                            Tag="{Binding}" />

                                    <!-- EDITAR -->

                                    <Button
                                            Content="✏"
                                            Width="34"
                                            Height="34"
                                            Margin="2"
                                            Cursor="Hand"
                                            Background="#2563EB"
                                            Foreground="White"
                                            BorderBrush="#2563EB"
                                            Click="btnEditar_Click"
                                            Tag="{Binding}"/>

                                    <!-- DOCUMENTOS -->

                                    <Button
                                            Content="📄"
                                            Width="34"
                                            Height="34"
                                            Margin="2"
                                            Cursor="Hand"
                                            Background="#7C3AED"
                                            Foreground="White"
                                            BorderBrush="#7C3AED"
                                            Click="btnDocumentos_Click"/>

                                    <!-- ELIMINAR -->

                                    <Button
                                            Content="🗑"
                                            Width="34"
                                            Height="34"
                                            Margin="2"
                                            Cursor="Hand"
                                            Background="#DC2626"
                                            Foreground="White"
                                            BorderBrush="#DC2626"
                                            Click="btnEliminar_Click"
                                            Tag="{Binding}"/>

                                </StackPanel>

                            </DataTemplate>

                        </DataGridTemplateColumn.CellTemplate>

                    </DataGridTemplateColumn>

                </DataGrid.Columns>

            </DataGrid>

        </Border>

    </Grid>

</Page>