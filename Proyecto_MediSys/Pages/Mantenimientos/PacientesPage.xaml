<Page x:Class="Proyecto_MediSys.Pages.Mantenimientos.PacientesPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
      Background="#F4F6F9">
   
    

    <Grid Margin="25">

        <!-- FILAS -->

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="110"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ========================================= -->
        <!-- TITULO -->
        <!-- ========================================= -->

        <StackPanel Grid.Row="0">

            <TextBlock Text="Gestión de Pacientes"
                       FontSize="30"
                       FontWeight="Bold"
                       Foreground="#1E293B"/>

            <TextBlock Text="Administración de pacientes registrados"
                       FontSize="15"
                       Foreground="Gray"
                       Margin="0,5,0,25"/>

        </StackPanel>

        <!-- ========================================= -->
        <!-- TARJETA -->
        <!-- ========================================= -->

        <Border Grid.Row="1"
                Width="230"
                Height="85"
                HorizontalAlignment="Left"
                CornerRadius="12"
                Background="White"
                BorderBrush="#E5E7EB"
                BorderThickness="1"
                Padding="15">

            <StackPanel>

                <TextBlock Text="👥 Total Pacientes"
                           FontSize="14"
                           Foreground="Gray"/>

                <TextBlock x:Name="txtTotalPacientes"
                           Text="0"
                           FontSize="30"
                           FontWeight="Bold"
                           Foreground="#2563EB"/>

            </StackPanel>

        </Border>

        <!-- ========================================= -->
        <!-- BUSCADOR -->
        <!-- ========================================= -->

        <Grid Grid.Row="2"
              Margin="0,15,0,20">

            <Grid.ColumnDefinitions>

                <ColumnDefinition Width="300"/>

                <ColumnDefinition Width="*"/>

                <ColumnDefinition Width="180"/>

            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Height="42"
                    CornerRadius="8"
                    Background="White"
                    BorderBrush="#D1D5DB"
                    BorderThickness="1">

                <DockPanel>

                    <TextBlock Text="🔍"
                               FontSize="18"
                               Margin="12,0"
                               VerticalAlignment="Center"/>

                    <TextBox x:Name="txtBuscar"
                             BorderThickness="0"
                             Background="Transparent"
                             FontSize="15"
                             VerticalContentAlignment="Center"
                             TextChanged="txtBuscar_TextChanged"/>

                </DockPanel>

            </Border>

            <!-- BOTON NUEVO -->

            <Button
                x:Name="btnNuevoPaciente"
                Grid.Column="2"
                Height="42"
                Cursor="Hand"
                FontSize="13"
                FontWeight="SemiBold"
                Foreground="White"
                Content="+  Nuevo paciente"
                Click="btnNuevoPaciente_Click">

                <Button.Style>

                    <Style TargetType="Button">

                        <Setter Property="Background"
                    Value="#2457A6"/>

                        <Setter Property="BorderThickness"
                    Value="0"/>

                        <Setter Property="Padding"
                    Value="15,5"/>

                        <Style.Triggers>

                            <Trigger Property="IsMouseOver"
                         Value="True">

                                <Setter Property="Background"
                            Value="#1E4A8C"/>

                            </Trigger>

                        </Style.Triggers>

                    </Style>

                </Button.Style>

            </Button>
        </Grid>

        <!-- ========================================= -->
        <!-- TABLA -->
        <!-- ========================================= -->

        <Border Grid.Row="3"
                Background="White"
                CornerRadius="12"
                Padding="10">

            <DataGrid x:Name="dgPacientes"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      IsReadOnly="True"
                      HeadersVisibility="Column"
                      GridLinesVisibility="Horizontal"
                      RowHeight="58"
                      FontSize="13"
                      BorderThickness="0"
                      Background="White"
                      AlternatingRowBackground="#FAFBFC"
                      HorizontalGridLinesBrush="#E8EDF2"
                      VerticalGridLinesBrush="Transparent"
                      SelectionMode="Single"
                      SelectionUnit="FullRow"
                      SelectionChanged="dgPacientes_SelectionChanged">  

                <DataGrid.ColumnHeaderStyle>

                    <Style TargetType="DataGridColumnHeader">

                        <Setter Property="Background"
                Value="#F1F5F9"/>

                        <Setter Property="Foreground"
                Value="#475569"/>

                        <Setter Property="FontWeight"
                Value="SemiBold"/>

                        <Setter Property="FontSize"
                Value="12"/>

                        <Setter Property="Height"
                Value="42"/>

                        <Setter Property="Padding"
                Value="10,0"/>

                        <Setter Property="BorderBrush"
                Value="#E2E8F0"/>

                        <Setter Property="BorderThickness"
                Value="0,0,0,1"/>

                        <Setter Property="VerticalContentAlignment"
                Value="Center"/>

                    </Style>

                </DataGrid.ColumnHeaderStyle>


                <DataGrid.CellStyle>

                    <Style TargetType="DataGridCell">

                        <Setter Property="BorderThickness"
                Value="0"/>

                        <Setter Property="Padding"
                Value="8,0"/>

                        <Setter Property="VerticalContentAlignment"
                Value="Center"/>

                        <Setter Property="Foreground"
                Value="#334155"/>

                        <Style.Triggers>

                            <Trigger Property="IsSelected"
                     Value="True">

                                <Setter Property="Background"
                        Value="#E8F0FC"/>

                                <Setter Property="Foreground"
                        Value="#1E293B"/>

                            </Trigger>

                        </Style.Triggers>

                    </Style>

                </DataGrid.CellStyle>

                <DataGrid.Columns>

                    <!-- FOTO -->

                    <DataGridTemplateColumn Header="Foto"
                            Width="75">

                        <DataGridTemplateColumn.CellTemplate>

                            <DataTemplate>

                                <Border Width="40"
                                        Height="40"
                                        CornerRadius="20"
                                        Background="#EEF2FF"
                                        BorderBrush="#4F46E5"
                                        BorderThickness="1"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center">     

                                <TextBlock Text="{Binding Iniciales}"
                                           FontWeight="Bold"
                                           FontSize="14"/>

                                </Border>

                            </DataTemplate>

                        </DataGridTemplateColumn.CellTemplate>

                    </DataGridTemplateColumn>
                    
                    

                    <!-- CODIGO -->

                    <DataGridTextColumn Header="Código"
                        Binding="{Binding CodigoPaciente}"
                        Width="120"/>      
                    
                    <!-- PACIENTE -->

                    <DataGridTemplateColumn Header="Paciente" Width="380">

                        <DataGridTemplateColumn.CellTemplate>

                            <DataTemplate>

                                <StackPanel Margin="5,2">

                                    <TextBlock
                                        Text="{Binding NombreCompleto}"
                                        FontWeight="SemiBold"
                                        FontSize="14"
                                        Foreground="#1E293B"/>      

                                    <TextBlock
                                        Text="{Binding DocumentoMostrar}"
                                        FontSize="11"
                                        Foreground="#6B7280"
                                        Margin="0,2,0,0"/>

                                </StackPanel>

                            </DataTemplate>

                        </DataGridTemplateColumn.CellTemplate>

                    </DataGridTemplateColumn>

                    <!-- EDAD -->
                    <DataGridTextColumn
                        Header="Edad"
                        Binding="{Binding Edad}"
                        Width="70"/>

                    <!-- TIPO -->

                    <DataGridTextColumn Header="Tipo"
                        Binding="{Binding NombreTipoPaciente}"
                        Width="120"/>

                    <!-- TELEFONO -->

                    <DataGridTextColumn Header="Teléfono"
                        Binding="{Binding Telefono}"
                        Width="120"/>

                    <!-- SEGURO -->

                    <DataGridTextColumn Header="Seguro"
                        Binding="{Binding NombreSeguro}"
                        Width="150"/>

                    <!-- ESTADO -->

                    <DataGridTextColumn Header="Estado"
                        Binding="{Binding NombreEstadoPaciente}"
                            Width="90"/>

                    <!-- ACCIONES -->

                    <DataGridTemplateColumn Header="Acciones"
                        Width="250">

                        <DataGridTemplateColumn.CellTemplate>

                            <DataTemplate>

                                <StackPanel
                Orientation="Horizontal"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Margin="5,0">

                                    <!-- VER -->

                                    <Button
                    Width="58"
                    Height="32"
                    Margin="3,0"
                    Background="#EEF2F6"
                    Foreground="#475569"
                    BorderThickness="0"
                    Click="btnVer_Click"
                    Tag="{Binding}"
                    ToolTip="Ver paciente"
                    Cursor="Hand">

                                        <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Center">

                                            <materialDesign:PackIcon
                            Kind="Eye"
                            Width="15"
                            Height="15"
                            Margin="0,0,5,0"
                            Foreground="#475569"/>

                                            <TextBlock
                            Text="Ver"
                            FontSize="11"
                            FontWeight="SemiBold"
                            VerticalAlignment="Center"/>

                                        </StackPanel>

                                    </Button>


                                    <!-- EDITAR -->

                                    <Button
                    Width="70"
                    Height="32"
                    Margin="3,0"
                    Background="#E8F1FC"
                    Foreground="#2457A6"
                    BorderThickness="0"
                    Click="btnEditar_Click"
                    Tag="{Binding}"
                    ToolTip="Editar paciente"
                    Cursor="Hand">

                                        <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Center">

                                            <materialDesign:PackIcon
                            Kind="Pencil"
                            Width="15"
                            Height="15"
                            Margin="0,0,5,0"
                            Foreground="#2457A6"/>

                                            <TextBlock
                            Text="Editar"
                            FontSize="11"
                            FontWeight="SemiBold"
                            VerticalAlignment="Center"/>

                                        </StackPanel>

                                    </Button>


                                    <!-- ELIMINAR -->

                                    <Button
                                        Width="78"
                                        Height="32"
                                        Margin="3,0"
                                        Background="#FCEEEE"
                                        Foreground="#A94442"
                                        BorderThickness="0"
                                        Click="btnEliminar_Click"
                                        Tag="{Binding}"
                                        ToolTip="Eliminar paciente"
                                        Cursor="Hand">

                                        <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Center">

                                            <materialDesign:PackIcon
                            Kind="Delete"
                            Width="15"
                            Height="15"
                            Margin="0,0,5,0"
                            Foreground="#A94442"/>

                                            <TextBlock
                            Text="Eliminar"
                            FontSize="11"
                            FontWeight="SemiBold"
                            VerticalAlignment="Center"/>

                                        </StackPanel>

                                    </Button>

                                </StackPanel>

                            </DataTemplate>

                        </DataGridTemplateColumn.CellTemplate>

                    </DataGridTemplateColumn>
                    
                </DataGrid.Columns>

            </DataGrid>

        </Border>

    </Grid>

</Page>